<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.ProjectSettingsWorkspaceView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <Grid ColumnDefinitions="220,*"
        ColumnSpacing="{StaticResource Space.Shell}"
        Panel.ZIndex="1"
        IsVisible="{Binding Shell.IsProjectSettingsSection}">
    <Border Grid.Column="0"
            Classes="PanelCard ProjectWorkspaceSidebarCard">
      <Grid RowDefinitions="Auto,*"
            RowSpacing="{StaticResource Space.3}">
        <StackPanel Spacing="2">
          <TextBlock Classes="SectionTitle"
                     Text="{Binding Summary.ProjectSettingsSidebarTitle}" />
          <TextBlock Classes="CaptionText"
                     Text="{Binding Summary.ProjectSettingsSidebarDescription}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled">
          <Border Classes="ProjectSettingsSidebarCard">
            <StackPanel Spacing="{StaticResource Space.4}">
              <StackPanel Spacing="{StaticResource Space.2}">
                <TextBlock Classes="ProjectSettingsGroupTitle"
                           Text="{Binding Summary.ProjectSettingsOverviewGroupTitle}" />
                <Button Classes="ProjectSettingsSidebarItemButton"
                        Classes.ProjectSettingsSidebarItemSelected="{Binding Settings.IsOverviewSelected}"
                        Command="{Binding Settings.ShowOverviewCommand}">
                  <TextBlock Text="{Binding Summary.ProjectSettingsOverviewGroupTitle}" />
                </Button>
              </StackPanel>

              <StackPanel Spacing="{StaticResource Space.2}">
                <TextBlock Classes="ProjectSettingsGroupTitle"
                           Text="{Binding Summary.ProjectSettingsImportGroupTitle}" />
                <Button Classes="ProjectSettingsSidebarItemButton"
                        Classes.ProjectSettingsSidebarItemSelected="{Binding Settings.IsImportDataSelected}"
                        Command="{Binding Settings.ShowImportDataCommand}">
                  <TextBlock Text="{Binding Summary.ProjectSettingsImportDataTitle}" />
                </Button>
                <Button Classes="ProjectSettingsSidebarItemButton"
                        Classes.ProjectSettingsSidebarItemSelected="{Binding Settings.IsExportDataSelected}"
                        Command="{Binding Settings.ShowExportDataCommand}">
                  <TextBlock Text="{Binding Summary.ProjectSettingsExportDataTitle}" />
                </Button>
              </StackPanel>

              <Border Classes="ProjectSettingsSidebarMetaCard">
                <StackPanel Spacing="{StaticResource Space.2}">
                  <TextBlock Text="{Binding Project.DisplayName}"
                             FontWeight="SemiBold" />
                  <TextBlock Classes="CaptionText"
                             Text="{Binding Summary.CurrentEnvironmentSummaryText}" />
                  <TextBlock Classes="CaptionText"
                             Text="{Binding Summary.ImportedApiDocumentSummaryText}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Classes="PanelCard ProjectWorkspaceCanvas">
      <Grid RowDefinitions="Auto,*"
            RowSpacing="{StaticResource Space.4}">
        <Grid>
          <StackPanel Spacing="2">
            <TextBlock Classes="SectionTitle"
                       Text="{Binding Settings.CurrentTitle}" />
            <TextBlock Classes="CaptionText"
                       Text="{Binding Settings.CurrentSubtitle}"
                       IsVisible="{Binding Settings.IsImportDataSelected}" />
            <TextBlock Classes="CaptionText"
                       Text="{Binding Settings.CurrentSubtitle}"
                       IsVisible="{Binding Settings.IsExportDataSelected}" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding Settings.IsOverviewSelected}">
            <StackPanel Spacing="{StaticResource Space.4}">
              <Border Classes="ProjectSettingsInfoCard">
                <StackPanel Spacing="{StaticResource Space.3}">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="SectionTitle"
                               Text="{Binding Summary.ProjectSettingsOverviewCardTitle}" />
                    <TextBlock Classes="CaptionText"
                               Text="{Binding Summary.ProjectSettingsOverviewCardDescription}" />
                  </StackPanel>

                  <Border Classes="ProjectSettingsBasicCard">
                    <StackPanel>
                      <Border Classes="ProjectSettingsBasicRow">
                        <Grid ColumnDefinitions="90,*,Auto"
                              ColumnSpacing="{StaticResource Space.4}">
                          <TextBlock Classes="ProjectSettingsRowLabel"
                                     Text="项目名称" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Project.Name}"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="2"
                                  Classes="ProjectSettingsInlineActionButton"
                                  Command="{Binding Settings.OpenRenameProjectDialogCommand}"
                                  Content="编辑" />
                        </Grid>
                      </Border>

                      <Border Classes="ProjectSettingsBasicRow">
                        <Grid ColumnDefinitions="90,*,Auto"
                              ColumnSpacing="{StaticResource Space.4}">
                          <TextBlock Classes="ProjectSettingsRowLabel"
                                     Text="项目 ID" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding ProjectId}"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="2"
                                  Classes="ProjectSettingsInlineActionButton"
                                  Content="复制"
                                  Command="{Binding Settings.CopyProjectIdCommand}" />
                        </Grid>
                      </Border>

                      <Border Classes="ProjectSettingsBasicRow ProjectSettingsBasicRowLast">
                        <Grid ColumnDefinitions="90,*,Auto"
                              ColumnSpacing="{StaticResource Space.4}">
                          <TextBlock Classes="ProjectSettingsRowLabel"
                                     Text="简介" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Settings.ProjectDescription}"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="2"
                                  Classes="ProjectSettingsInlineActionButton"
                                  Command="{Binding Settings.OpenEditProjectDescriptionDialogCommand}"
                                  Content="编辑" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border Classes="SettingsPageSection SettingsDangerSection">
                <StackPanel Spacing="{StaticResource Space.3}">
                  <StackPanel Spacing="2">
              <TextBlock Classes="SettingsGroupTitle DialogDangerText"
                               Text="{Binding Summary.ProjectSettingsDangerCardTitle}" />
                    <TextBlock Classes="CaptionText"
                               Text="{Binding Summary.ProjectSettingsDangerCardDescription}"
                               TextWrapping="Wrap" />
                  </StackPanel>

                  <Border Classes="ProjectSettingsBasicCard">
                    <StackPanel>
                      <Border Classes="ProjectSettingsBasicRow">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="{StaticResource Space.4}">
                          <StackPanel Spacing="4">
                            <TextBlock Classes="ProjectSettingsRowLabel"
                                       Text="{Binding Summary.ProjectSettingsClearProjectDataTitle}" />
                            <TextBlock Classes="CaptionText"
                                       Text="{Binding Summary.ProjectSettingsClearProjectDataDescription}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Classes="DialogDangerButton"
                                  Content="{Binding Settings.ClearProjectDataButtonText}"
                                  IsEnabled="{Binding Settings.CanRunProjectDangerOperation}"
                                  Command="{Binding Settings.RequestClearProjectDataCommand}" />
                        </Grid>
                      </Border>

                      <Border Classes="ProjectSettingsBasicRow ProjectSettingsBasicRowLast">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="{StaticResource Space.4}">
                          <StackPanel Spacing="4">
                            <TextBlock Classes="ProjectSettingsRowLabel"
                                       Text="{Binding Summary.ProjectSettingsDeleteProjectTitle}" />
                            <TextBlock Classes="CaptionText"
                                       Text="{Binding Summary.ProjectSettingsDeleteProjectDescription}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Classes="DialogDangerButton"
                                  Content="{Binding Settings.DeleteProjectButtonText}"
                                  IsEnabled="{Binding Settings.CanRunProjectDangerOperation}"
                                  Command="{Binding Settings.RequestDeleteProjectCommand}" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock Classes="CaptionText"
                             Text="{Binding Settings.ProjectDangerOperationStatus}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding Settings.IsImportDataSelected}">
            <StackPanel Spacing="{StaticResource Space.4}">
              <Border Classes="ProjectSettingsInfoCard">
                <StackPanel Spacing="{StaticResource Space.3}">
                  <Border Classes="ProjectSettingsSectionDivider" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="SectionTitle"
                               Text="{Binding Summary.ProjectSettingsImportCardTitle}" />
                    <TextBlock Classes="CaptionText"
                               Text="{Binding Summary.ProjectSettingsImportCardDescription}" />
                  </StackPanel>
                  <Button Classes="ProjectImportCatalogButton"
                          Command="{Binding Import.OpenDialogCommand}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{StaticResource Space.3}">
                      <Border Width="42"
                              Height="42"
                              Classes="ProjectImportFormatIcon">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource Font.Size.BodyLarge}"
                                   FontWeight="Bold"
                                   Text="S" />
                      </Border>
                      <StackPanel Grid.Column="1"
                                  Spacing="2"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary.ProjectSettingsImportFormatName}"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="CaptionText"
                                   Text="{Binding Summary.ProjectSettingsImportFormatDescription}" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Border Classes="ProjectSettingsSectionDivider" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="SectionTitle"
                               Text="{Binding Summary.ProjectSettingsImportPackageCardTitle}" />
                    <TextBlock Classes="CaptionText"
                               Text="{Binding Summary.ProjectSettingsImportPackageCardDescription}" />
                  </StackPanel>
                  <Button Classes="ProjectImportCatalogButton"
                          Command="{Binding Import.ImportProjectDataPackageFileCommand}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{StaticResource Space.3}">
                      <Border Width="42"
                              Height="42"
                              Classes="ProjectImportFormatIcon">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource Font.Size.BodyLarge}"
                                   FontWeight="Bold"
                                   Text="P" />
                      </Border>
                      <StackPanel Grid.Column="1"
                                  Spacing="2"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary.ProjectSettingsImportPackageFormatName}"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="CaptionText"
                                   Text="{Binding Summary.ProjectSettingsImportPackageFormatDescription}" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Border Classes="ProjectSettingsSectionDivider" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="SectionTitle" Text="导入请求用例交付包" />
                    <TextBlock Classes="CaptionText"
                               Text="先预览接口、请求用例、环境和变量，再按项选择覆盖、跳过或另存。"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Classes="ProjectImportCatalogButton"
                          Command="{Binding Import.Delivery.OpenImportCommand}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{StaticResource Space.3}">
                      <Border Width="42"
                              Height="42"
                              Classes="ProjectImportFormatIcon">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource Font.Size.BodyLarge}"
                                   FontWeight="Bold"
                                   Text="U" />
                      </Border>
                      <StackPanel Grid.Column="1"
                                  Spacing="2"
                                  VerticalAlignment="Center">
                        <TextBlock Text="请求用例交付包"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="CaptionText"
                                   Text="导入 .apixdelivery.json，并保留环境配置与变量值"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Border Classes="ProjectSettingsSectionDivider" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="SectionTitle" Text="最近导入" />
                    <TextBlock Classes="CaptionText" Text="当前项目最近导入的 OpenAPI / Swagger / Postman 文档。" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Import.ImportedApiDocuments}"
                                IsVisible="{Binding Import.HasImportedApiDocuments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectImportedDocumentItemViewModel">
                        <Border Classes="ProjectSettingsImportHistoryRow">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space.3}">
                            <TextBlock Classes="CaptionText" Text="{Binding ImportedAtText}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.1}">
                                <TextBlock Classes="CaptionText" Text="{Binding SourceTypeText}" />
                                <TextBlock Classes="CaptionText" Text="·" />
                                <TextBlock Classes="CaptionText" Text="接口" />
                                <TextBlock Classes="CaptionText" Text="{Binding EndpointCountText}" />
                                <TextBlock Classes="CaptionText" Text="个" />
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Classes="CaptionText"
                                       Text="{Binding SourceValueText}"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="CaptionText"
                             Text="暂无导入记录。"
                             IsVisible="{Binding Import.ShowImportedApiDocumentsEmptyState}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding Settings.IsExportDataSelected}">
            <StackPanel Spacing="{StaticResource Space.4}">
              <Border Classes="ProjectSettingsInfoCard">
                <StackPanel Spacing="{StaticResource Space.3}">
                  <Border Classes="ProjectSettingsSectionDivider" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="SectionTitle"
                               Text="{Binding Summary.ProjectSettingsExportCardTitle}" />
                    <TextBlock Classes="CaptionText"
                               Text="{Binding Summary.ProjectSettingsExportCardDescription}" />
                  </StackPanel>

                  <!-- 对齐原型 09：三格式胶囊切换（.body-mode chips），四项范围仅备份格式显示 -->
                  <StackPanel Orientation="Horizontal"
                              Spacing="6">
                    <ToggleButton Classes="ExportFormatChip"
                                  Command="{Binding Import.SelectExportFormatCommand}"
                                  CommandParameter="backup"
                                  IsChecked="{Binding Import.IsBackupExportFormat, Mode=OneWay}">
                      <TextBlock Text="ApixPress 备份" />
                    </ToggleButton>
                    <ToggleButton Classes="ExportFormatChip"
                                  Command="{Binding Import.SelectExportFormatCommand}"
                                  CommandParameter="html"
                                  IsChecked="{Binding Import.IsHtmlExportFormat, Mode=OneWay}">
                      <TextBlock Text="HTML" />
                    </ToggleButton>
                    <ToggleButton Classes="ExportFormatChip"
                                  Command="{Binding Import.SelectExportFormatCommand}"
                                  CommandParameter="markdown"
                                  IsChecked="{Binding Import.IsMarkdownExportFormat, Mode=OneWay}">
                      <TextBlock Text="Markdown" />
                    </ToggleButton>
                  </StackPanel>

                  <StackPanel Spacing="{StaticResource Space.2}"
                              IsVisible="{Binding Import.IsBackupExportFormat}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource Space.3}">
                      <CheckBox Content="接口与目录"
                                IsChecked="{Binding Import.ExportIncludeInterfaces}" />
                      <CheckBox Content="请求用例"
                                IsChecked="{Binding Import.ExportIncludeRequestCases}" />
                      <CheckBox Content="环境变量"
                                IsChecked="{Binding Import.ExportIncludeEnvironments}" />
                      <CheckBox Content="请求历史"
                                IsChecked="{Binding Import.ExportIncludeRequestHistory}" />
                    </StackPanel>
                    <TextBlock Classes="CaptionText"
                               Text="导出位置：导出时再次确认；未勾选请求用例的父接口被排除时，对应用例不会导出。" />
                    <Button Classes="DialogPrimaryButton"
                            Content="{Binding Import.ExportActionButtonText}"
                            Command="{Binding Import.ExportProjectDataCommand}" />
                  </StackPanel>

                  <StackPanel Spacing="{StaticResource Space.2}"
                              IsVisible="{Binding Import.IsHtmlExportFormat}">
                    <TextBlock Classes="CaptionText"
                               Text="将接口目录与接口文档导出为单个静态 HTML 页面（含请求用例示例），适合浏览器浏览与分享。"
                               TextWrapping="Wrap" />
                    <Button Classes="DialogPrimaryButton"
                            Content="{Binding Import.ExportActionButtonText}"
                            Command="{Binding Import.ExportProjectDataCommand}" />
                  </StackPanel>

                  <StackPanel Spacing="{StaticResource Space.2}"
                              IsVisible="{Binding Import.IsMarkdownExportFormat}">
                    <TextBlock Classes="CaptionText"
                               Text="将接口目录与接口文档导出为 Markdown 文件（索引 + 每个目录一个 .md，含请求用例示例），适合放入 Git 仓库。"
                               TextWrapping="Wrap" />
                    <Button Classes="DialogPrimaryButton"
                            Content="{Binding Import.ExportActionButtonText}"
                            Command="{Binding Import.ExportProjectDataCommand}" />
                  </StackPanel>

                  <Border Classes="ProjectSettingsSectionDivider" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="SectionTitle" Text="导出请求用例交付包" />
                    <TextBlock Classes="CaptionText"
                               Text="选择接口或请求用例，自动携带父接口，并导出全部环境和变量。"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Classes="ProjectImportCatalogButton"
                          Command="{Binding Import.Delivery.OpenExportCommand}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{StaticResource Space.3}">
                      <Border Width="42"
                              Height="42"
                              Classes="ProjectImportFormatIcon">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource Font.Size.BodyLarge}"
                                   FontWeight="Bold"
                                   Text="D" />
                      </Border>
                      <StackPanel Grid.Column="1"
                                  Spacing="2"
                                  VerticalAlignment="Center">
                        <TextBlock Text="请求用例交付包"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="CaptionText"
                                   Text="导出为 .apixdelivery.json，便于跨项目交付"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.ColumnSpan="2"
            Classes="CreateProjectDialogBackdrop"
            IsVisible="{Binding Settings.IsClearProjectDataConfirmDialogOpen}">
      <Grid HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Border Classes="SettingsDangerConfirmCard">
          <StackPanel Spacing="{StaticResource Space.4}">
            <StackPanel Spacing="{StaticResource Space.2}">
              <TextBlock Classes="DialogTitle DialogDangerText"
                         Text="确认清空项目数据？" />
              <TextBlock Classes="CaptionText"
                         Text="{Binding Project.Name, StringFormat='将清空项目 {0} 的接口、用例、导入文档、环境变量和请求历史，项目本身会保留。'}"
                         TextWrapping="Wrap" />
            <Border Classes="DialogDangerNotice">
              <StackPanel Spacing="2">
                <TextBlock Classes="DialogDangerText" Text="该操作无法恢复" />
                <TextBlock Classes="CaptionText" Text="项目本身会保留，但接口、用例、环境变量和请求历史将被清空。" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            </StackPanel>
            <Border Classes="CreateProjectDialogDivider" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="{StaticResource Space.2}">
              <Button Classes="DialogSecondaryButton"
                      Content="取消"
                      Command="{Binding Settings.CancelClearProjectDataCommand}" />
              <Button Classes="DialogDangerButton"
                      Content="{Binding Settings.ClearProjectDataButtonText}"
                      Command="{Binding Settings.ConfirmClearProjectDataCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.ColumnSpan="2"
            Classes="CreateProjectDialogBackdrop"
            IsVisible="{Binding Settings.IsDeleteProjectConfirmDialogOpen}">
      <Grid HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Border Classes="SettingsDangerConfirmCard">
          <StackPanel Spacing="{StaticResource Space.4}">
            <StackPanel Spacing="{StaticResource Space.2}">
              <TextBlock Classes="DialogTitle DialogDangerText"
                         Text="确认删除项目？" />
              <TextBlock Classes="CaptionText"
                         Text="{Binding Project.Name, StringFormat='项目 {0} 会被删除，相关接口、用例、导入文档、环境配置和请求历史都会一并删除，不能撤销。'}"
                         TextWrapping="Wrap" />
            <Border Classes="DialogDangerNotice">
              <StackPanel Spacing="2">
                <TextBlock Classes="DialogDangerText" Text="该操作无法恢复" />
                <TextBlock Classes="CaptionText" Text="项目及其接口、用例、导入文档、环境配置和请求历史都会被删除。" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            </StackPanel>
            <Border Classes="CreateProjectDialogDivider" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="{StaticResource Space.2}">
              <Button Classes="DialogSecondaryButton"
                      Content="取消"
                      Command="{Binding Settings.CancelDeleteProjectCommand}" />
              <Button Classes="DialogDangerButton"
                      Content="{Binding Settings.DeleteProjectButtonText}"
                      Command="{Binding Settings.ConfirmDeleteProjectCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.ColumnSpan="2"
            Classes="ProjectSettingsDangerOperationOverlay"
            IsVisible="{Binding Settings.IsProjectDangerOperationBusy}">
      <Border Classes="ProjectWorkspaceLoadingCard">
        <StackPanel Spacing="{StaticResource Space.3}">
          <ProgressBar Classes="ProjectWorkspaceLoadingProgress"
                       IsIndeterminate="True" />
          <StackPanel Spacing="{StaticResource Space.1}">
            <TextBlock Classes="SectionTitle"
                       HorizontalAlignment="Center"
                       Text="正在处理" />
            <TextBlock Classes="CaptionText"
                       HorizontalAlignment="Center"
                       Text="{Binding Settings.ProjectDangerOperationStatus}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
