<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.RequestCodeDialogView"
             x:DataType="vm:ProjectRequestEditorViewModel"
             mc:Ignorable="d">
  <!-- 弹窗 chrome 由 Ursa StandardDialogControl 提供；DataContext 为请求编辑 VM -->
  <Border Classes="RequestCodeDialogCard">
    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="{StaticResource Space.3}"
          MinHeight="0">
      <Border Grid.Row="0"
              Classes="RequestCodeDialogSidebar">
        <StackPanel Classes="RequestCodeDialogLanguageList"
                    Orientation="Horizontal">
          <ToggleButton Classes="RequestCodeDialogLanguageToggle"
                        Command="{Binding ShowShellRequestCodeLanguageCommand}"
                        IsChecked="{Binding IsShellRequestCodeLanguageSelected, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="{StaticResource Space.2}">
              <TextBlock Grid.Column="0"
                         Classes="RequestCodeDialogLanguageGlyph"
                         Text="&gt;_" />
              <TextBlock Grid.Column="1"
                         Classes="RequestCodeDialogLanguageText"
                         Text="Shell(3)" />
            </Grid>
          </ToggleButton>
          <ToggleButton Classes="RequestCodeDialogLanguageToggle"
                        Command="{Binding ShowCSharpRequestCodeLanguageCommand}"
                        IsChecked="{Binding IsCSharpRequestCodeLanguageSelected, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="{StaticResource Space.2}">
              <TextBlock Grid.Column="0"
                         Classes="RequestCodeDialogLanguageGlyph"
                         Text="{}" />
              <TextBlock Grid.Column="1"
                         Classes="RequestCodeDialogLanguageText"
                         Text="C#(1)" />
            </Grid>
          </ToggleButton>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="{StaticResource Space.2}"
            MinHeight="0">
        <TextBlock Grid.Row="0"
                   Classes="SectionTitle RequestCodeDialogSectionTitle"
                   Text="{Binding CurrentRequestCodeLanguageTitle}" />

        <Border Grid.Row="1"
                Classes="RequestCodeDialogEditorCard"
                IsVisible="{Binding IsShellRequestCodeLanguageSelected}">
          <TabControl Classes="RequestCodeDialogTabs"
                      SelectedIndex="{Binding SelectedRequestCodeTab, Mode=TwoWay}">
            <TabItem Header="curl">
              <TextBox Classes="RequestCodeDialogTextBox"
                       AcceptsReturn="True"
                       IsReadOnly="True"
                       TextWrapping="NoWrap"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       Text="{Binding RequestCodeCurlCommand}"
                       FontFamily="{StaticResource Font.Monospace}" />
            </TabItem>
            <TabItem Header="wget">
              <TextBox Classes="RequestCodeDialogTextBox"
                       AcceptsReturn="True"
                       IsReadOnly="True"
                       TextWrapping="NoWrap"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       Text="{Binding RequestCodeWgetCommand}"
                       FontFamily="{StaticResource Font.Monospace}" />
            </TabItem>
            <TabItem Header="powershell">
              <TextBox Classes="RequestCodeDialogTextBox"
                       AcceptsReturn="True"
                       IsReadOnly="True"
                       TextWrapping="NoWrap"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       Text="{Binding RequestCodePowerShellCommand}"
                       FontFamily="{StaticResource Font.Monospace}" />
            </TabItem>
          </TabControl>
        </Border>

        <Border Grid.Row="1"
                Classes="RequestCodeDialogEditorCard"
                IsVisible="{Binding IsCSharpRequestCodeLanguageSelected}">
          <TextBox Classes="RequestCodeDialogTextBox"
                   AcceptsReturn="True"
                   IsReadOnly="True"
                   TextWrapping="NoWrap"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Text="{Binding RequestCodeCSharpCommand}"
                   FontFamily="{StaticResource Font.Monospace}" />
        </Border>

        <!-- 对齐原型 10 modal-foot：复制反馈提示 + 关闭/复制代码按钮 -->
        <Border Grid.Row="2" Classes="DialogFooter">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space.2}">
            <TextBlock Grid.Column="0"
                       Classes="CaptionText"
                       VerticalAlignment="Center"
                       Text="{Binding RequestCodeCopiedHint}" />
            <Button Grid.Column="1"
                    Classes="DialogSecondaryButton"
                    Content="关闭"
                    Command="{Binding CloseRequestCodeDialogCommand}" />
            <Button Grid.Column="2"
                    Classes="DialogPrimaryButton"
                    Content="复制代码"
                    Command="{Binding CopyRequestCodeCommand}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
