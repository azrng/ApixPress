<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iri="https://irihi.tech/shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:views="using:ApixPress.App.Views.Controls"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.RequestHistoryDetailView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <Border Classes="PanelCard ProjectWorkspaceCanvas">
    <u:LoadingContainer IsLoading="{Binding HistoryPanel.IsHistoryLoading}"
                        LoadingMessage="正在加载请求历史"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
      <Grid RowDefinitions="Auto,Auto,*"
            RowSpacing="{StaticResource Space.3}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            MinWidth="0"
            MinHeight="0">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="{StaticResource Space.2}">
        <StackPanel Spacing="2">
          <TextBlock Classes="SectionTitle"
                     Text="请求历史详情" />
          <TextBlock Classes="CaptionText"
                     Text="选择左侧历史记录查看请求参数和响应；继续请求会按地址类型打开可编辑的请求标签。" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="SecondaryButton"
                Content="继续请求"
                IsEnabled="{Binding HistoryPanel.HasSelectedHistory}"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadHistoryItemCommand}"
                CommandParameter="{Binding HistoryPanel.SelectedHistoryItem}" />
      </Grid>

      <Border Grid.Row="1"
              Classes="PanelCard HistoryRequestDetailCard">
        <Grid>
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="{StaticResource Space.2}"
              IsVisible="{Binding HistoryPanel.HasSelectedHistory}">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="{StaticResource Space.2}">
            <u:Badge Grid.Column="0"
                     Header="{Binding HistoryPanel.SelectedHistoryItem.Method}"
                     iri:ClassHelper.Classes="{Binding HistoryPanel.SelectedHistoryItem.MethodBadgeClass}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding HistoryPanel.SelectedHistoryItem.Url}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Classes="CaptionText"
                       Text="{Binding HistoryPanel.SelectedHistoryItem.TimestampText}"
                       VerticalAlignment="Center" />
          </Grid>

          <TabControl Grid.Row="1"
                      Classes="HistoryRequestDetailTabs">
            <TabItem Header="参数">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource Space.2}">
                  <TextBlock Classes="CaptionText"
                             Text="查询参数"
                             IsVisible="{Binding HistoryPanel.SelectedHistoryItem.HasQueryParameters}" />
                  <ItemsControl ItemsSource="{Binding HistoryPanel.SelectedHistoryItem.RequestSnapshot.QueryParameters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="HistoryRequestKeyValueRow">
                          <Grid ColumnDefinitions="*,*"
                                ColumnSpacing="{StaticResource Space.2}">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="CaptionText"
                             Text="路径参数"
                             IsVisible="{Binding HistoryPanel.SelectedHistoryItem.HasPathParameters}" />
                  <ItemsControl ItemsSource="{Binding HistoryPanel.SelectedHistoryItem.RequestSnapshot.PathParameters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="HistoryRequestKeyValueRow">
                          <Grid ColumnDefinitions="*,*"
                                ColumnSpacing="{StaticResource Space.2}">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="CaptionText"
                             Text="此请求没有查询或路径参数。"
                             IsVisible="{Binding !HistoryPanel.SelectedHistoryItem.HasRequestParameters}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Headers">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource Space.2}">
                  <ItemsControl ItemsSource="{Binding HistoryPanel.SelectedHistoryItem.RequestSnapshot.Headers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="HistoryRequestKeyValueRow">
                          <Grid ColumnDefinitions="*,*"
                                ColumnSpacing="{StaticResource Space.2}">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="CaptionText"
                             Text="暂无自定义 Header。"
                             IsVisible="{Binding !HistoryPanel.SelectedHistoryItem.HasRequestHeaders}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="实际请求">
              <!-- 实际发出的请求快照（对齐原型「实际请求」tab） -->
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource Space.2}">
                  <Border Classes="HistoryRequestKeyValueRow">
                    <Grid ColumnDefinitions="120,*"
                          ColumnSpacing="{StaticResource Space.2}">
                      <TextBlock Text="请求行" />
                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="{StaticResource Space.1}">
                        <TextBlock Classes="HistoryRequestKvValue"
                                   Text="{Binding HistoryPanel.SelectedHistoryItem.Method}" />
                        <TextBlock Classes="HistoryRequestKvValue"
                                   Text="{Binding HistoryPanel.SelectedHistoryItem.Url}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="HistoryRequestKeyValueRow">
                    <Grid ColumnDefinitions="120,*"
                          ColumnSpacing="{StaticResource Space.2}">
                      <TextBlock Text="Body" />
                      <TextBlock Grid.Column="1"
                                 Classes="HistoryRequestKvValue"
                                 Text="{Binding HistoryPanel.SelectedHistoryItem.RequestSnapshot.BodyContent}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="3"
                                 IsVisible="{Binding HistoryPanel.SelectedHistoryItem.HasRequestBody}" />
                      <TextBlock Grid.Column="1"
                                 Classes="CaptionText"
                                 Text="-"
                                 IsVisible="{Binding !HistoryPanel.SelectedHistoryItem.HasRequestBody}" />
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Body">
              <!-- 大请求体不换行（改由横向滚动查看）且展示截断预览，避免 MB 级快照 Wrap 全文排版卡顿 -->
              <TextBox Classes="HistoryRequestBodyPreview"
                       AcceptsReturn="True"
                       IsReadOnly="True"
                       Text="{Binding HistoryPanel.SelectedHistoryItem.RequestBodyDisplayText}"
                       PlaceholderText="此请求没有 Body"
                       TextWrapping="NoWrap"
                       VerticalContentAlignment="Top" />
            </TabItem>
          </TabControl>
        </Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource Space.2}"
                    IsVisible="{Binding !HistoryPanel.HasSelectedHistory}">
          <TextBlock Classes="SubtleText" Text="选择左侧历史记录后查看请求快照。" />
        </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2"
              Classes="PanelCard ResponsePanelCard">
        <!-- 响应区右键：复制所选历史的响应 Body / Headers（历史记录无编辑器状态，不提供 cURL） -->
        <Border.ContextMenu>
          <ContextMenu Classes="WorkspaceTabContextMenu">
            <MenuItem Classes="WorkspaceTabContextMenuItem"
                      Header="复制响应 Body"
                      Command="{Binding Editor.CopyResponseBodyCommand}"
                      CommandParameter="{Binding HistoryPanel.SelectedResponseSection}">
              <MenuItem.Icon>
                <TextBlock Classes="WorkspaceTabContextMenuIcon"
                           Text="&#xE7C3;" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Classes="WorkspaceTabContextMenuItem"
                      Header="复制 Headers"
                      Command="{Binding Editor.CopyResponseHeadersCommand}"
                      CommandParameter="{Binding HistoryPanel.SelectedResponseSection}">
              <MenuItem.Icon>
                <TextBlock Classes="WorkspaceTabContextMenuIcon"
                           Text="&#xE8FD;" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Border.ContextMenu>
        <DockPanel>
          <Grid DockPanel.Dock="Top"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="{StaticResource Space.2}"
                Margin="{StaticResource Pad.Bottom3}">
            <TextBlock Classes="SectionTitle"
                       Text="所选请求的响应" />
            <TextBlock Grid.Column="1"
                       Classes="CaptionText"
                       Text="{Binding Summary.CurrentEnvironmentLabel}"
                       VerticalAlignment="Center" />
            <!-- 历史详情响应复制：CommandParameter 指向所选记录的响应区；历史记录无编辑器状态，不提供 cURL 项 -->
            <Button Grid.Column="2"
                    Classes="HttpResponseCopyButton"
                    ToolTip.Tip="复制响应内容"
                    IsVisible="{Binding HistoryPanel.SelectedResponseSection.HasResponse}">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         Text="&#xE8C8;" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="复制响应 Body"
                            Command="{Binding Editor.CopyResponseBodyCommand}"
                            CommandParameter="{Binding HistoryPanel.SelectedResponseSection}">
                    <MenuItem.Icon>
                      <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 Text="&#xE7C3;" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="复制 Headers"
                            Command="{Binding Editor.CopyResponseHeadersCommand}"
                            CommandParameter="{Binding HistoryPanel.SelectedResponseSection}">
                    <MenuItem.Icon>
                      <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 Text="&#xE8FD;" />
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>

          <StackPanel IsVisible="{Binding HistoryPanel.SelectedResponseSection.ShowPlaceholder}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="{StaticResource Space.2}">
            <TextBlock Classes="SubtleText"
                       Text="选择左侧历史记录后，可在这里查看响应内容。" />
          </StackPanel>

          <Grid IsVisible="{Binding HistoryPanel.SelectedResponseSection.HasResponse}"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="{StaticResource Space.2}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                  ColumnSpacing="{StaticResource Space.3}">
              <u:Badge Grid.Column="0"
                       Header="{Binding HistoryPanel.SelectedResponseSection.StatusText}"
                       iri:ClassHelper.Classes="{Binding HistoryPanel.SelectedResponseSection.StatusBadgeClass}" />
              <TextBlock Grid.Column="1"
                         Classes="CaptionText"
                         Text="{Binding HistoryPanel.SelectedResponseSection.DurationText}" />
              <TextBlock Grid.Column="2"
                         Classes="CaptionText"
                         Text="{Binding HistoryPanel.SelectedResponseSection.SizeText}" />
            </Grid>

            <!-- 异常响应横幅：404/5xx/超时 等（与调试页一致）；失败/5xx 可重发该条历史，错误文本可选中复制 -->
            <Border Grid.Row="1"
                    Classes="HttpResponseNoticeCard HttpResponseNoticeBanner"
                    Classes.HttpResponseNoticeDanger="{Binding HistoryPanel.SelectedResponseSection.IsNoticeDanger}"
                    Classes.HttpResponseNoticeWarning="{Binding HistoryPanel.SelectedResponseSection.IsNoticeWarning}"
                    IsVisible="{Binding HistoryPanel.SelectedResponseSection.ShowResponseNotice}">
              <StackPanel Orientation="Horizontal"
                          Spacing="{StaticResource Space.2}">
                <TextBlock Classes="HttpResponseNoticeTitle"
                           Text="{Binding HistoryPanel.SelectedResponseSection.ResponseNoticeTitle}" />
                <SelectableTextBlock Classes="CaptionText HttpResponseNoticeText"
                                     VerticalAlignment="Center"
                                     Text="{Binding HistoryPanel.SelectedResponseSection.ResponseNoticeText}"
                                     TextTrimming="CharacterEllipsis" />
                <Button Classes="HttpResponseNoticeRetryButton"
                        Content="重试"
                        IsVisible="{Binding HistoryPanel.SelectedResponseSection.CanRetryRequest}"
                        Command="{Binding ResendHistoryRequestCommand}"
                        CommandParameter="{Binding HistoryPanel.SelectedHistoryItem}" />
              </StackPanel>
            </Border>

            <TabControl Grid.Row="3"
                        Classes="ResponseTabs"
                        SelectedIndex="{Binding HistoryPanel.SelectedResponseSection.SelectedResponseTab}">
              <TabItem Header="Body">
                <!-- 大响应体不换行（改由横向滚动查看），避免 MB 级文本 Wrap 全文排版卡顿 -->
                <TextBox AcceptsReturn="True"
                         BorderThickness="0"
                         Background="Transparent"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalContentAlignment="Top"
                         Text="{Binding HistoryPanel.SelectedResponseSection.BodyText}"
                         FontFamily="{StaticResource Font.Monospace}" />
              </TabItem>
              <TabItem Header="Headers">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <Border Classes="HttpResponseKvGrid"
                          IsVisible="{Binding HistoryPanel.SelectedResponseSection.HasHeaderRows}">
                    <ItemsControl ItemsSource="{Binding HistoryPanel.SelectedResponseSection.HeaderRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResponseHeaderRowViewModel">
                          <Border Classes="HttpResponseKvRow">
                            <Grid ColumnDefinitions="220,*"
                                  ColumnSpacing="{StaticResource Space.4}">
                              <TextBlock Classes="HttpResponseKvKey"
                                         Text="{Binding Name}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1"
                                         Classes="HttpResponseKvValue"
                                         Text="{Binding Value}"
                                         TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="实际请求">
                <views:ActualRequestPanelView DataContext="{Binding HistoryPanel.SelectedResponseSection}" />
              </TabItem>
            </TabControl>
          </Grid>
        </DockPanel>
      </Border>
      </Grid>
    </u:LoadingContainer>
  </Border>
</UserControl>
