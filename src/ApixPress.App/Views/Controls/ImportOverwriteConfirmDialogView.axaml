<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ApixPress.App.Models.DTOs"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.ImportOverwriteConfirmDialogView"
             x:DataType="vm:ImportOverwriteConfirmDialogViewModel"
             mc:Ignorable="d">
  <!-- 弹窗 chrome 由 Ursa StandardDialogControl 提供；DataContext 为覆盖确认独立上下文，经 Import 访问导入数据；
       DialogNoDefaultSubmit：覆盖是破坏性操作，禁用 Enter 默认提交，避免误触（ESC 关闭不受影响） -->
  <Border Classes="ImportOverwriteConfirmDialogCard DialogNoDefaultSubmit">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="{StaticResource Space.3}">
      <StackPanel Spacing="2">
        <TextBlock Classes="SectionTitle"
                   Text="处理同名接口" />
        <TextBlock Classes="CaptionText"
                   Text="{Binding Import.PendingImportOverwriteTitle, StringFormat='导入文档：{0}'}"
                   IsVisible="{Binding Import.HasPendingImportPreview}" />
        <TextBlock Classes="CaptionText ImportConflictWarning"
                   Text="覆盖会更新同路径接口定义；已保存的请求用例会保留。"
                   IsVisible="{Binding Import.IsOverwriteImportSelected}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="1"
                  Spacing="{StaticResource Space.2}">
        <TextBlock Classes="CaptionText"
                   Text="{Binding Import.PendingImportOverwriteSummary}"
                   TextWrapping="Wrap" />

        <TextBlock Classes="SectionTitle"
                   Text="同名接口清单"
                   IsVisible="{Binding Import.HasImportConflicts}" />
        <Border Classes="ImportConflictListCard"
                IsVisible="{Binding Import.HasImportConflicts}">
          <ScrollViewer Classes="ImportConflictListViewport">
            <ItemsControl ItemsSource="{Binding Import.PendingImportConflicts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ApiImportConflictDto">
                  <Border Classes="ImportConflictRow">
                    <Grid ColumnDefinitions="56,*"
                          ColumnSpacing="{StaticResource Space.3}">
                      <TextBlock Classes="ImportConflictMethod"
                                 Text="{Binding Method}" />
                      <StackPanel Grid.Column="1"
                                  Spacing="1">
                        <TextBlock Classes="ImportConflictPath"
                                   Text="{Binding Path}"
                                   ToolTip.Tip="{Binding Path}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="CaptionText ImportConflictExisting"
                                   Text="{Binding ExistingDocumentName, StringFormat='现有：{0}'}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="2" Spacing="{StaticResource Space.2}">
        <TextBlock Classes="CaptionText" Text="选择处理方式" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.2}">
          <ToggleButton Grid.Column="0"
                        Classes="ImportResolutionChoice"
                        IsChecked="{Binding Import.IsOverwriteImportSelected, Mode=OneWay}"
                        Command="{Binding Import.ChooseOverwriteImportCommand}">
            <StackPanel Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="覆盖现有接口" />
              <TextBlock Classes="CaptionText" Text="参数与说明以导入文档为准" TextWrapping="Wrap" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Grid.Column="1"
                        Classes="ImportResolutionChoice"
                        IsChecked="{Binding Import.SkipSameNameInterfaces, Mode=OneWay}"
                        Command="{Binding Import.ChooseSkipSameNameInterfacesCommand}">
            <StackPanel Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="跳过同名接口" />
              <TextBlock Classes="CaptionText" Text="仅导入新接口，不改动现有接口" TextWrapping="Wrap" />
            </StackPanel>
          </ToggleButton>
        </Grid>
      </StackPanel>

      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="{StaticResource Space.2}">
        <Button Classes="DialogSecondaryButton"
                Content="取消"
                Command="{Binding CancelCommand}" />
        <Button Classes="DialogPrimaryButton"
                Content="覆盖并导入"
                IsVisible="{Binding Import.IsOverwriteImportSelected}"
                Command="{Binding ConfirmCommand}" />
        <Button Classes="DialogPrimaryButton"
                Content="跳过重复项并导入"
                IsVisible="{Binding Import.SkipSameNameInterfaces}"
                Command="{Binding ConfirmCommand}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
