<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.ProjectInnerTabBarView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <!-- 项目内请求标签栏：独立于标题栏的目录（项目）标签，挂在整个项目工作区上方（对齐原型 inner-tabbar） -->
  <Border Classes="ProjectInnerTabBar">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="{StaticResource Space.1}">
      <Border Grid.Column="0"
              Classes="ProjectWorkspaceTabViewport">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled">
          <TabStrip Classes="ProjectWorkspaceEditorTabs"
                    ItemsSource="{Binding Workspace.VisibleWorkspaceTabs}"
                    SelectedItem="{Binding Workspace.ActiveWorkspaceTab, Mode=TwoWay}">
            <TabStrip.ItemTemplate>
              <DataTemplate x:DataType="vm:RequestWorkspaceTabViewModel">
                <Border Classes="ProjectWorkspaceInnerTabCapsule">
                  <Border.ContextMenu>
                    <ContextMenu Classes="WorkspaceTabContextMenu"
                                 DataContext="{Binding}">
                      <MenuItem Classes="WorkspaceTabContextMenuItem"
                                Header="{Binding PinMenuHeader}"
                                Command="{Binding TogglePinCommand}">
                        <MenuItem.Icon>
                          <TextBlock Classes="WorkspaceTabContextMenuIcon"
                                     Text="&#xE718;" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Classes="WorkspaceTabContextMenuItem"
                                Header="关闭当前标签页"
                                IsEnabled="{Binding CanCloseFromTab}"
                                Command="{Binding CloseCurrentFromTabMenuCommand}">
                        <MenuItem.Icon>
                          <TextBlock Classes="WorkspaceTabContextMenuIcon"
                                     Text="&#xE711;" />
                        </MenuItem.Icon>
                        <MenuItem.InputGesture>Ctrl+W</MenuItem.InputGesture>
                      </MenuItem>
                      <MenuItem Classes="WorkspaceTabContextMenuItem"
                                Header="关闭其它标签页"
                                Command="{Binding CloseOtherFromTabMenuCommand}" />
                      <MenuItem Classes="WorkspaceTabContextMenuItem"
                                Header="关闭全部标签页"
                                Command="{Binding CloseAllFromTabMenuCommand}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="{StaticResource Space.1}">
                    <TextBlock Grid.Column="0"
                               MaxWidth="180"
                               VerticalAlignment="Center"
                               Text="{Binding HeaderText}"
                                ToolTip.Tip="{Binding HeaderText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Classes="ProjectWorkspaceUnsavedGlyph"
                               IsVisible="{Binding ShowUnsavedChanges}"
                               Text="●" />
                    <TextBlock Grid.Column="2"
                               Classes="ProjectWorkspacePinnedGlyph"
                               IsVisible="{Binding IsPinned}"
                               Text="&#xE718;" />
                    <Button Grid.Column="3"
                            Classes="ProjectWorkspaceInnerTabCloseButton"
                            IsVisible="{Binding CanCloseFromTab}"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActiveProjectTab.Workspace.CloseWorkspaceTabCommand}"
                            CommandParameter="{Binding}"
                            Content="×" />
                  </Grid>
                </Border>
              </DataTemplate>
            </TabStrip.ItemTemplate>
          </TabStrip>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1"
            Height="22"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"
                    Spacing="{StaticResource Space.1}">
          <Button Classes="ProjectWorkspaceInnerTabAddButton"
                  Content="+"
                  Command="{Binding Workspace.CreateWorkspaceTabCommand}"
                  ToolTip.Tip="新建工作标签" />
          <Button x:Name="WorkspaceTabMenuButton"
                  Classes="ProjectWorkspaceInnerTabMoreButton"
                  Content="..."
                  Click="OnWorkspaceTabMenuButtonClick">
            <Button.ContextMenu>
              <ContextMenu x:Name="WorkspaceTabMoreContextMenu"
                           Classes="WorkspaceTabContextMenu"
                           DataContext="{Binding}"
                           Opened="OnWorkspaceTabMoreContextMenuOpened"
                           Closed="OnWorkspaceTabMoreContextMenuClosed">
                <MenuItem Header="恢复关闭的标签"
                          Command="{Binding Workspace.RestoreClosedWorkspaceTabCommand}"
                          InputGesture="Ctrl+Shift+T" />
                <Separator />
                <MenuItem Classes="WorkspaceTabContextMenuItem"
                          Header="关闭当前标签页"
                          IsEnabled="{Binding ActiveWorkspaceTab.CanCloseFromTab}"
                          Command="{Binding Workspace.CloseCurrentWorkspaceFromMenuCommand}">
                  <MenuItem.Icon>
                    <TextBlock Classes="WorkspaceTabContextMenuIcon"
                               Text="&#xE711;" />
                  </MenuItem.Icon>
                  <MenuItem.InputGesture>Ctrl+W</MenuItem.InputGesture>
                </MenuItem>
                <MenuItem Classes="WorkspaceTabContextMenuItem"
                          Header="关闭其它标签页"
                          Command="{Binding Workspace.CloseOtherWorkspaceTabsCommand}" />
                <MenuItem Classes="WorkspaceTabContextMenuItem"
                          Header="关闭全部标签页"
                          Command="{Binding Workspace.CloseAllWorkspaceTabsCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="WorkspaceTabListButton"
                  Classes="HttpSaveButton"
                  Content="所有标签"
                  AutomationProperties.Name="所有已打开的标签">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <!-- 所有标签弹层：结构化卡片（标题+计数、当前项高亮、未保存标记、恢复入口） -->
                <Grid Classes="WorkspaceTabListCard"
                      RowDefinitions="Auto,*,Auto">
                  <Grid Grid.Row="0"
                        Classes="WorkspaceTabListHead"
                        ColumnDefinitions="*,Auto">
                    <TextBlock Classes="WorkspaceTabListTitle"
                               Text="打开的标签" />
                    <Border Grid.Column="1"
                            Classes="WorkspaceTabListCountBadge">
                      <TextBlock Classes="WorkspaceTabListCountText"
                                 Text="{Binding Workspace.VisibleWorkspaceTabs.Count}" />
                    </Border>
                  </Grid>

                  <ScrollViewer Grid.Row="1"
                                Classes="WorkspaceTabListScroll"
                                MaxHeight="300">
                    <ItemsControl ItemsSource="{Binding Workspace.VisibleWorkspaceTabs}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RequestWorkspaceTabViewModel">
                          <!-- Flyout 内编译绑定跨层查找会静默断链：激活走 code-behind，命令不写在这里 -->
                          <Button Classes="WorkspaceTabListItem"
                                  Click="OnWorkspaceTabListItemClick"
                                  AutomationProperties.Name="{Binding HeaderText}">
                            <Grid ColumnDefinitions="Auto,Auto,*"
                                  ColumnSpacing="{StaticResource Space.1}">
                              <Border Grid.ColumnSpan="3"
                                      Classes="WorkspaceTabListItemActiveBackdrop"
                                      IsVisible="{Binding IsActive}" />
                              <TextBlock Grid.Column="0"
                                         Classes="WorkspaceTabListCheckGlyph"
                                         IsVisible="{Binding IsActive}"
                                         Text="&#x2713;" />
                              <TextBlock Grid.Column="1"
                                         Classes="WorkspaceTabListUnsavedGlyph"
                                         IsVisible="{Binding ShowUnsavedChanges}"
                                         Text="&#x25CF;"
                                         ToolTip.Tip="有未保存修改" />
                              <TextBlock Grid.Column="2"
                                         Classes="WorkspaceTabListItemText"
                                         Text="{Binding HeaderText}"
                                         ToolTip.Tip="{Binding HeaderText}"
                                         TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <TextBlock Grid.Row="1"
                             Classes="WorkspaceTabListEmpty"
                             IsVisible="{Binding !Workspace.HasVisibleWorkspaceTabs}"
                             Text="当前没有打开的标签" />

                  <StackPanel Grid.Row="2">
                    <Border Classes="WorkspaceTabListSeparator" />
                    <Button Classes="WorkspaceTabListRestoreButton"
                            Command="{Binding Workspace.RestoreClosedWorkspaceTabCommand}">
                      <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="WorkspaceTabListRestoreText"
                                 Text="恢复关闭的标签" />
                        <TextBlock Grid.Column="1"
                                   Classes="WorkspaceTabListShortcutText"
                                   Text="Ctrl+Shift+T" />
                      </Grid>
                    </Button>
                  </StackPanel>
                </Grid>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
