<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:views="using:ApixPress.App.Views.Controls"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.HttpDocumentWorkspaceView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                IsVisible="{Binding Editor.ShowHttpDocumentPreviewContent}">
    <StackPanel Spacing="{StaticResource Space.3}"
                MinWidth="0">
      <Border Classes="PanelCard HttpDocumentHeroCard">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource Space.4}"
              MinWidth="0"
              ClipToBounds="True">
          <StackPanel Grid.Column="0"
                      MinWidth="0"
                      Spacing="{StaticResource Space.3}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.2}">
              <u:Badge Header="{Binding Editor.SelectedMethod}" />
              <u:Badge Header="{Binding Editor.CurrentResponseValidationResultText}" />
            </StackPanel>

            <TextBlock Classes="PageTitle"
                       Text="{Binding Editor.CurrentHttpInterfaceDisplayName}" />

            <Border Classes="HttpDocumentUrlCard">
              <StackPanel Spacing="4">
                <TextBlock Classes="CaptionText"
                           Text="请求地址" />
                <TextBlock Text="{Binding Editor.CurrentHttpDocumentUrl}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Column="1"
                  Classes="HttpDocumentCaseActionCard"
                  IsVisible="{Binding Editor.ShowSaveHttpCaseAction}">
            <StackPanel Spacing="{StaticResource Space.2}">
              <TextBlock Classes="CaptionText"
                         Text="测试用例" />
              <TextBlock Text="{Binding Editor.CurrentHttpCaseName}"
                         TextTrimming="CharacterEllipsis" />
              <Button Classes="HttpSaveButton"
                      Content="保存测试用例"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveHttpCaseCommand}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="1.3*,*"
            ColumnSpacing="{StaticResource Space.3}"
            MinWidth="0">
        <StackPanel Spacing="{StaticResource Space.3}"
                    MinWidth="0">
          <Border Classes="PanelCard HttpDocumentPreviewCard">
            <StackPanel Spacing="{StaticResource Space.3}">
              <TextBlock Classes="SectionTitle"
                         Text="请求概览" />
              <!-- 对齐原型 info-row：标签列 + 值列 + 行分隔线 -->
              <Border Classes="HttpDocumentInfoRow">
                <Grid ColumnDefinitions="96,*"
                      ColumnSpacing="{StaticResource Space.3}">
                  <TextBlock Classes="CaptionText HttpDocumentInfoLabel" Text="接口目录" />
                  <TextBlock Grid.Column="1" Text="{Binding Editor.CurrentInterfaceFolderPath}" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Classes="HttpDocumentInfoRow">
                <Grid ColumnDefinitions="96,*"
                      ColumnSpacing="{StaticResource Space.3}">
                  <TextBlock Classes="CaptionText HttpDocumentInfoLabel" Text="BaseUrl" />
                  <TextBlock Grid.Column="1" Text="{Binding Editor.CurrentEditorBaseUrlCaption}" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Classes="HttpDocumentInfoRow">
                <Grid ColumnDefinitions="96,*"
                      ColumnSpacing="{StaticResource Space.3}">
                  <TextBlock Classes="CaptionText HttpDocumentInfoLabel" Text="接口用例" />
                  <TextBlock Grid.Column="1" Text="{Binding Editor.CurrentHttpCaseName}" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Classes="HttpDocumentInfoRow HttpDocumentInfoRowLast">
                <Grid ColumnDefinitions="96,*"
                      ColumnSpacing="{StaticResource Space.3}">
                  <TextBlock Classes="CaptionText HttpDocumentInfoLabel" Text="Body 模式" />
                  <TextBlock Grid.Column="1" Text="{Binding Editor.CurrentHttpDocumentBodyModeText}" TextWrapping="Wrap" />
                </Grid>
              </Border>

              <!-- 接口说明编辑承接原「设计」页签，唯一编辑入口 -->
              <StackPanel Spacing="{StaticResource Space.2}">
                <TextBlock Classes="CaptionText HttpDocumentInfoLabel"
                           Text="接口说明" />
                <TextBox Classes="SectionInput HttpDocumentDescriptionInput"
                         AcceptsReturn="True"
                         Text="{Binding ConfigTab.RequestDescription}"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         PlaceholderText="补充接口用途、前置条件和返回约定" />
              </StackPanel>

              <TextBlock Classes="CaptionText"
                         IsVisible="{Binding Editor.ShowHttpDocumentRequestEmpty}"
                         Text="当前还没有补充参数、Header 或请求体内容。" />
            </StackPanel>
          </Border>

          <Border Classes="PanelCard HttpDocumentPreviewCard"
                  IsVisible="{Binding Editor.HasHttpDocumentParameters}">
            <StackPanel Spacing="{StaticResource Space.3}">
              <TextBlock Classes="SectionTitle"
                         Text="Query 参数" />
              <ItemsControl ItemsSource="{Binding ConfigTab.QueryParameters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RequestParameterItemViewModel">
                    <Border Classes="HttpDocumentKeyValueRow">
                      <Grid ColumnDefinitions="*,*"
                            ColumnSpacing="{StaticResource Space.3}">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Classes="CaptionText" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="PanelCard HttpDocumentPreviewCard"
                  IsVisible="{Binding Editor.HasHttpDocumentHeaders}">
            <StackPanel Spacing="{StaticResource Space.3}">
              <TextBlock Classes="SectionTitle"
                         Text="Headers" />
              <ItemsControl ItemsSource="{Binding ConfigTab.Headers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RequestParameterItemViewModel">
                    <Border Classes="HttpDocumentKeyValueRow">
                      <Grid ColumnDefinitions="*,*"
                            ColumnSpacing="{StaticResource Space.3}">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Classes="CaptionText" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    MinWidth="0"
                    Spacing="{StaticResource Space.3}">
          <Border Classes="PanelCard HttpDocumentPreviewCard">
            <StackPanel Spacing="{StaticResource Space.3}">
              <TextBlock Classes="SectionTitle"
                         Text="响应示例" />
              <TextBlock Classes="CaptionText"
                         Text="{Binding Editor.CurrentHttpDocumentResponseSummary}" />
              <!-- 大响应（上限 256K 字符）只排版可视区：Wrap TextBox 会对整篇文本重建 TextLayout 阻塞 UI 线程 -->
              <Border Classes="HttpDocumentPreviewCodeCard HttpDocumentCodeCardTall"
                      IsVisible="{Binding Editor.HasHttpDocumentBodyPreview}">
                <views:ResponseBodyEditor Text="{Binding Editor.CurrentHttpDocumentBodyPreview}" />
              </Border>
              <Border Classes="HttpConfigEmptyState"
                      IsVisible="{Binding !Editor.HasHttpDocumentBodyPreview}">
                <TextBlock Classes="CaptionText"
                           Text="尚未调试，发送请求后生成响应示例。" />
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="PanelCard HttpDocumentPreviewCard">
            <StackPanel Spacing="{StaticResource Space.3}">
              <TextBlock Classes="SectionTitle"
                         Text="请求示例" />
              <Border Classes="HttpDocumentPreviewCodeCard HttpDocumentCodeCardLow">
                <views:ResponseBodyEditor Text="{Binding Editor.CurrentHttpDocumentCurlSnippet}" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
