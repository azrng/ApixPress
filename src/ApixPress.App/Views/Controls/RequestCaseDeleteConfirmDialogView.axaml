<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.RequestCaseDeleteConfirmDialogView"
             x:DataType="vm:RequestCaseDeleteConfirmDialogViewModel"
             mc:Ignorable="d">
  <Border Classes="DialogDangerCard">
    <Grid RowDefinitions="Auto,Auto,Auto"
          RowSpacing="{StaticResource Space.3}">
      <StackPanel Spacing="2">
        <TextBlock Classes="DialogTitle DialogDangerText"
                   Text="删除用例" />
        <TextBlock Classes="CaptionText"
                   Text="{Binding CaseName, StringFormat='即将删除：{0}'}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <Border Grid.Row="1" Classes="DialogDangerNotice">
        <TextBlock Classes="DialogDangerText"
                   Text="删除后无法恢复，请确认继续。"
                   TextWrapping="Wrap" />
      </Border>

      <Border Grid.Row="2"
              Classes="DialogFooter">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{StaticResource Space.2}">
          <Button Classes="DialogSecondaryButton"
                  Content="取消"
                  Command="{Binding CancelCommand}" />
          <Button Classes="DialogDangerButton"
                  Content="确认删除"
                  Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
