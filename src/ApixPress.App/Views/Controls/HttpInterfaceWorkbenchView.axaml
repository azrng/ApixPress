<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iri="https://irihi.tech/shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:views="using:ApixPress.App.Views.Controls"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.HttpInterfaceWorkbenchView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <Grid RowDefinitions="Auto,*"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowSpacing="0"
        MinHeight="0"
        ClipToBounds="True"
        IsVisible="{Binding Editor.ShowHttpWorkbenchContent}">
    <Border Grid.Row="0"
            Classes="PanelCard HttpDesignMetaCard"
            IsVisible="{Binding Editor.IsHttpDesignEditorMode}">
      <StackPanel Spacing="{StaticResource Space.3}">
        <StackPanel Spacing="2">
          <TextBlock Classes="SectionTitle"
                     Text="接口设计" />
          <TextBlock Classes="CaptionText"
                     Text="这里只保留接口说明，用于补充接口用途、前置条件和返回约定。" />
        </StackPanel>

        <StackPanel Spacing="{StaticResource Space.2}">
          <TextBlock Classes="CaptionText"
                     Text="接口说明" />
          <TextBox Classes="SectionInput HttpDesignMultilineInput"
                   AcceptsReturn="True"
                   Text="{Binding ConfigTab.RequestDescription}"
                   TextWrapping="Wrap"
                   VerticalContentAlignment="Top"
                   PlaceholderText="补充接口用途、前置条件和返回约定" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1"
          RowSpacing="0"
          MinHeight="0"
          ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"
                       MinHeight="170"
                       MaxHeight="{Binding ConfigTab.ConfigPanelMaxHeight}" />
        <RowDefinition Height="6" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- 对齐原型：URL 行、Params/Body/Headers 子标签与参数表格同属一张配置卡片 -->
      <Border Grid.Row="0"
              Classes="PanelCard ProjectWorkspaceSettingsCard HttpWorkbenchConfigCard"
              Padding="0"
              MinHeight="170"
              MaxHeight="{Binding ConfigTab.ConfigPanelMaxHeight}">
        <Grid RowDefinitions="Auto,Auto,*">
          <views:HttpRequestUrlRowView Grid.Row="0" />
          <TabControl Grid.Row="1"
                      Classes="ConfigTabControl HttpRequestTabs"
                      SelectedIndex="{Binding ConfigTab.SelectedTabIndex}">
            <TabItem Header="Params" />
            <TabItem Header="Body" />
            <TabItem Header="Headers" />
          </TabControl>
          <Grid x:Name="ConfigTabContentHost"
                Grid.Row="2"
                MinHeight="0"
                ClipToBounds="True" />
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1"
                    Classes="HttpWorkbenchSplitter"
                    ResizeDirection="Rows"
                    HorizontalAlignment="Stretch" />

      <Border Grid.Row="2"
              Classes="PanelCard HttpResponseCard">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="{StaticResource Space.2}">
          <Grid Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="{StaticResource Space.3}">
            <TextBlock Grid.Column="0"
                       Classes="SectionTitle"
                       Text="返回响应" />
            <Grid Grid.Column="2"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="{StaticResource Space.2}"
                  HorizontalAlignment="Right"
                  IsVisible="{Binding ResponseSection.HasResponse}">
              <TextBox Grid.Column="0"
                       Classes="SectionInput HttpResponseSearchInput"
                       PlaceholderText="搜索响应"
                       Text="{Binding ResponseSection.BodySearchText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Column="1"
                         Classes="CaptionText"
                         VerticalAlignment="Center"
                         Text="{Binding ResponseSection.BodySearchResultText}" />
              <u:Badge Grid.Column="2"
                       Header="{Binding ResponseSection.StatusText}"
                       iri:ClassHelper.Classes="{Binding ResponseSection.StatusBadgeClass}" />
              <TextBlock Grid.Column="3"
                         Classes="CaptionText"
                         VerticalAlignment="Center"
                         Text="{Binding ResponseSection.DurationText}" />
              <TextBlock Grid.Column="4"
                         Classes="CaptionText"
                         VerticalAlignment="Center"
                         Text="{Binding ResponseSection.SizeText}" />
            </Grid>
          </Grid>

          <!-- 响应状态提示横幅：独占一行，按严重度着色左侧色条 -->
          <Border Grid.Row="1"
                  Classes="HttpResponseNoticeCard HttpResponseNoticeBanner"
                  Classes.HttpResponseNoticeDanger="{Binding ResponseSection.IsNoticeDanger}"
                  Classes.HttpResponseNoticeWarning="{Binding ResponseSection.IsNoticeWarning}"
                  IsVisible="{Binding ResponseSection.ShowResponseNotice}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.2}">
              <TextBlock Classes="HttpResponseNoticeTitle"
                         Text="{Binding ResponseSection.ResponseNoticeTitle}" />
              <TextBlock Classes="CaptionText"
                         VerticalAlignment="Center"
                         Text="{Binding ResponseSection.ResponseNoticeText}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2"
                  Classes="HttpResponsePlaceholderHost"
                  IsVisible="{Binding ResponseSection.ShowPlaceholder}">
            <Border Classes="HttpResponsePlaceholderCard">
              <StackPanel Classes="HttpResponsePlaceholderContent"
                          Spacing="{StaticResource Space.3}">
                <Border Classes="HttpResponsePlaceholderIcon">
                  <PathIcon Data="{StaticResource SemiIconCloudStroked}"
                            Width="26"
                            Height="26" />
                </Border>
                <TextBlock Classes="HttpResponsePlaceholderTitle"
                           Text="点击“发送”按钮获取返回结果" />
                <TextBlock Classes="SubtleText HttpResponsePlaceholderText"
                           Text="支持查看 Body 与 Headers、搜索响应内容、自动格式化 JSON" />
              </StackPanel>
            </Border>
          </Border>

          <Grid Grid.Row="2"
                IsVisible="{Binding ResponseSection.HasResponse}"
                RowDefinitions="*">
            <TabControl Grid.Row="0"
                        Classes="ResponseTabs"
                        SelectedIndex="{Binding ResponseSection.SelectedResponseTab}">
              <TabItem Header="Body">
                <Border Classes="HttpResponseBodyCard"
                        Margin="{StaticResource Pad.Top2}">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Classes="HttpResponseBodyViewer"
                               views:JsonSyntaxHighlight.Text="{Binding ResponseSection.BodyText}" />
                  </ScrollViewer>
                </Border>
              </TabItem>
              <TabItem Header="Headers">
                <Border Classes="HttpResponseBodyCard"
                        Margin="{StaticResource Pad.Top2}">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Classes="HttpResponseBodyViewer"
                               Text="{Binding ResponseSection.HeadersText}" />
                  </ScrollViewer>
                </Border>
              </TabItem>
            </TabControl>
          </Grid>

          <Border Grid.Row="2"
                  Classes="HttpResponseLoadingOverlay"
                  IsVisible="{Binding ResponseSection.IsLoading}">
            <StackPanel Classes="HttpResponseLoadingContent"
                        Spacing="{StaticResource Space.3}">
              <ProgressBar Classes="HttpResponseLoadingProgress"
                           IsIndeterminate="True" />
              <TextBlock Classes="SubtleText HttpResponseLoadingText"
                         Text="{Binding ResponseSection.LoadingText}" />
              <Button Classes="DialogSecondaryButton HttpResponseCancelButton"
                      HorizontalAlignment="Center"
                      Content="取消请求"
                      Command="{Binding CancelRequestCommand}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
