<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iri="https://irihi.tech/shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:views="using:ApixPress.App.Views.Controls"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.HttpInterfaceWorkbenchView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        MinHeight="0"
        ClipToBounds="True"
        IsVisible="{Binding Editor.ShowHttpWorkbenchContent}">
    <Grid RowSpacing="0"
          MinHeight="0"
          ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"
                       MinHeight="170"
                       MaxHeight="{Binding ConfigTab.ConfigPanelMaxHeight}" />
        <RowDefinition Height="6" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- 对齐原型：URL 行、Params/Body/Headers 子标签与参数表格同属一张配置卡片 -->
      <Border Grid.Row="0"
              Classes="PanelCard ProjectWorkspaceSettingsCard HttpWorkbenchConfigCard"
              Padding="0"
              MinHeight="170"
              MaxHeight="{Binding ConfigTab.ConfigPanelMaxHeight}">
        <Grid RowDefinitions="Auto,Auto,*">
          <views:HttpRequestUrlRowView Grid.Row="0" />
          <TabControl Grid.Row="1"
                      Classes="ConfigTabControl HttpRequestTabs"
                      SelectedIndex="{Binding ConfigTab.SelectedTabIndex}">
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.1}">
                  <TextBlock Text="Params" />
                  <u:Badge Header="{Binding ConfigTab.QueryParameterCountText}"
                           IsVisible="{Binding ConfigTab.HasQueryParameters}" />
                </StackPanel>
              </TabItem.Header>
            </TabItem>
            <TabItem Header="Body" />
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.1}">
                  <TextBlock Text="Headers" />
                  <u:Badge Header="{Binding ConfigTab.HeaderCountText}"
                           IsVisible="{Binding ConfigTab.HasHeaders}" />
                </StackPanel>
              </TabItem.Header>
            </TabItem>
          </TabControl>
          <Grid x:Name="ConfigTabContentHost"
                Grid.Row="2"
                MinHeight="0"
                ClipToBounds="True" />
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1"
                    Classes="HttpWorkbenchSplitter"
                    ResizeDirection="Rows"
                    HorizontalAlignment="Stretch" />

      <Border Grid.Row="2"
              Classes="PanelCard HttpResponseCard">
        <!-- 响应区右键：复制响应 Body / Headers / cURL（DataContext 即 ProjectTabViewModel，纯路径绑定） -->
        <Border.ContextMenu>
          <ContextMenu Classes="WorkspaceTabContextMenu">
            <MenuItem Classes="WorkspaceTabContextMenuItem"
                      Header="复制响应 Body"
                      Command="{Binding Editor.CopyResponseBodyCommand}"
                      CommandParameter="{Binding ResponseSection}">
              <MenuItem.Icon>
                <TextBlock Classes="WorkspaceTabContextMenuIcon"
                           Text="&#xE7C3;" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Classes="WorkspaceTabContextMenuItem"
                      Header="复制 Headers"
                      Command="{Binding Editor.CopyResponseHeadersCommand}"
                      CommandParameter="{Binding ResponseSection}">
              <MenuItem.Icon>
                <TextBlock Classes="WorkspaceTabContextMenuIcon"
                           Text="&#xE8FD;" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Classes="WorkspaceTabContextMenuItem"
                      Header="复制 cURL"
                      Command="{Binding Editor.CopyCurrentRequestCurlCommand}">
              <MenuItem.Icon>
                <TextBlock Classes="WorkspaceTabContextMenuIcon"
                           Text="&#xE756;" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Border.ContextMenu>
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="{StaticResource Space.2}">
          <Grid Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="{StaticResource Space.3}">
            <TextBlock Grid.Column="0"
                       Classes="SectionTitle"
                       Text="返回响应" />
            <Grid Grid.Column="2"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="{StaticResource Space.2}"
                  HorizontalAlignment="Right"
                  IsVisible="{Binding ResponseSection.HasResponse}">
              <TextBox Grid.Column="0"
                       Classes="SectionInput HttpResponseSearchInput"
                       PlaceholderText="搜索响应"
                       Text="{Binding ResponseSection.BodySearchText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Column="1"
                         Classes="CaptionText"
                         VerticalAlignment="Center"
                         Text="{Binding ResponseSection.BodySearchResultText}" />
              <u:Badge Grid.Column="2"
                       Header="{Binding ResponseSection.StatusText}"
                       iri:ClassHelper.Classes="{Binding ResponseSection.StatusBadgeClass}" />
              <TextBlock Grid.Column="3"
                         Classes="CaptionText"
                         VerticalAlignment="Center"
                         Text="{Binding ResponseSection.DurationText}" />
              <TextBlock Grid.Column="4"
                         Classes="CaptionText"
                         VerticalAlignment="Center"
                         Text="{Binding ResponseSection.SizeText}" />
              <!-- 响应复制菜单：DataContext 路径绑定（MenuFlyout 内 $parent 查找会断链，禁止使用） -->
              <Button Grid.Column="5"
                      Classes="HttpResponseCopyButton"
                      ToolTip.Tip="复制响应内容">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Text="&#xE8C8;" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="复制响应 Body"
                              Command="{Binding Editor.CopyResponseBodyCommand}"
                              CommandParameter="{Binding ResponseSection}">
                      <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Text="&#xE7C3;" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="复制 Headers"
                              Command="{Binding Editor.CopyResponseHeadersCommand}"
                              CommandParameter="{Binding ResponseSection}">
                      <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Text="&#xE8FD;" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="复制 cURL"
                              Command="{Binding Editor.CopyCurrentRequestCurlCommand}">
                      <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Text="&#xE756;" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Grid>

          <!-- 响应状态提示横幅：独占一行，按严重度着色左侧色条；失败/5xx 提供一键重试，错误文本可选中复制 -->
          <Border Grid.Row="1"
                  Classes="HttpResponseNoticeCard HttpResponseNoticeBanner"
                  Classes.HttpResponseNoticeDanger="{Binding ResponseSection.IsNoticeDanger}"
                  Classes.HttpResponseNoticeWarning="{Binding ResponseSection.IsNoticeWarning}"
                  IsVisible="{Binding ResponseSection.ShowResponseNotice}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.2}">
              <TextBlock Classes="HttpResponseNoticeTitle"
                         Text="{Binding ResponseSection.ResponseNoticeTitle}" />
              <SelectableTextBlock Classes="CaptionText HttpResponseNoticeText"
                                   VerticalAlignment="Center"
                                   Text="{Binding ResponseSection.ResponseNoticeText}"
                                   TextTrimming="CharacterEllipsis" />
              <Button Classes="HttpResponseNoticeRetryButton"
                      Content="重试"
                      IsVisible="{Binding ResponseSection.CanRetryRequest}"
                      Command="{Binding SendRequestCommand}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2"
                  Classes="HttpResponsePlaceholderHost HttpResponsePlaceholderCard"
                  IsVisible="{Binding ResponseSection.ShowPlaceholder}">
            <StackPanel Classes="HttpResponsePlaceholderContent"
                        Spacing="{StaticResource Space.3}">
              <Border Classes="HttpResponsePlaceholderIcon">
                <Path Width="26"
                      Height="26"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Stroke="{DynamicResource Brush.Brand.Primary}"
                      StrokeThickness="1.7"
                      Fill="Transparent"
                      Data="M12,2 C15,4.5 16.5,8.5 16.5,12.5 L16.5,16 L7.5,16 L7.5,12.5 C7.5,8.5 9,4.5 12,2 M7.5,13 L4.5,16.5 L7.5,16 M16.5,13 L19.5,16.5 L16.5,16 M10.5,16 L10.5,19.5 L12,21.5 L13.5,19.5 L13.5,16 M12,7 L12,10" />
              </Border>
              <TextBlock Classes="HttpResponsePlaceholderTitle"
                         Text="等待响应" />
              <TextBlock Classes="HttpResponsePlaceholderText"
                         Text="当前请求尚未返回数据" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="2"
                IsVisible="{Binding ResponseSection.HasResponse}"
                RowDefinitions="*">
            <TabControl Grid.Row="0"
                        Classes="ResponseTabs"
                        SelectedIndex="{Binding ResponseSection.SelectedResponseTab}">
              <TabItem Header="Body">
                <Border Classes="HttpResponseBodyCard"
                        Margin="{StaticResource Pad.Top2}">
                  <!-- AvaloniaEdit 只读查看器：大响应仅排版可视区，替代整页 Run 构建的 SelectableTextBlock -->
                  <views:ResponseBodyEditor Text="{Binding ResponseSection.BodyText}" />
                </Border>
              </TabItem>
              <TabItem Header="Headers">
                <Border Classes="HttpResponseBodyCard"
                        Margin="{StaticResource Pad.Top2}">
                  <!-- 只读键值表（对齐原型 kv-grid）：左侧 Header 名 / 右侧值 -->
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <Border Classes="HttpResponseKvGrid"
                            IsVisible="{Binding ResponseSection.HasHeaderRows}">
                      <ItemsControl ItemsSource="{Binding ResponseSection.HeaderRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ResponseHeaderRowViewModel">
                            <Border Classes="HttpResponseKvRow">
                              <Grid ColumnDefinitions="220,*"
                                    ColumnSpacing="{StaticResource Space.4}">
                                <TextBlock Classes="HttpResponseKvKey"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Classes="HttpResponseKvValue"
                                           Text="{Binding Value}"
                                           TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </ScrollViewer>
                </Border>
              </TabItem>
              <TabItem Header="实际请求">
                <views:ActualRequestPanelView DataContext="{Binding ResponseSection}" />
              </TabItem>
            </TabControl>
          </Grid>

          <Border Grid.Row="2"
                  Classes="HttpResponseLoadingOverlay"
                  IsVisible="{Binding ResponseSection.IsLoading}">
            <StackPanel Classes="HttpResponseLoadingContent"
                        Spacing="{StaticResource Space.4}">
              <Path Classes="HttpSpinner HttpSpinnerViolet HttpSpinnerLarge"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center" />
              <StackPanel Spacing="{StaticResource Space.1}">
                <TextBlock Classes="HttpResponseLoadingText"
                           HorizontalAlignment="Center"
                           Text="{Binding ResponseSection.LoadingText}" />
                <TextBlock Classes="CaptionText HttpResponseLoadingHint"
                           HorizontalAlignment="Center"
                           Text="等待服务器响应，可点击「取消」中止本次请求。" />
              </StackPanel>
              <Button Classes="DialogSecondaryButton HttpResponseCancelButton"
                      HorizontalAlignment="Center"
                      Content="取消请求"
                      Command="{Binding CancelRequestCommand}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
