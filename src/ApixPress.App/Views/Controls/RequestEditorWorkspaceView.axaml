<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ApixPress.App.Views.Controls"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.RequestEditorWorkspaceView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <!-- 对齐原型：上下文栏与工作区卡片紧贴（无行距），URL 行并入工作区配置卡片 -->
  <Grid RowDefinitions="Auto,*"
        RowSpacing="0"
        MinHeight="0"
        ClipToBounds="True">
    <!-- 快捷请求：名称 + 生成代码 -->
    <Border Grid.Row="0"
            Classes="HttpQuickContextBar"
            IsVisible="{Binding Editor.IsQuickRequestEditor}">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="{StaticResource Space.2}">
        <TextBox Grid.Column="0"
                 Classes="SectionInput HttpInterfaceNameInput HttpToolbarNameInput"
                 HorizontalAlignment="Left"
                 PlaceholderText="未命名请求"
                 Text="{Binding Editor.CurrentQuickRequestName}" />
        <Button Grid.Column="1"
                Classes="IconButton HttpCodeIconButton"
                Command="{Binding Editor.OpenRequestCodeDialogCommand}"
                ToolTip.Tip="生成代码">
          <TextBlock Classes="HttpCodeIconGlyph"
                     Text="&lt;/&gt;" />
        </Button>
      </Grid>
    </Border>

    <!-- HTTP 接口：模式切换 + 接口名 + 生成代码 -->
    <Border Grid.Row="0"
            Classes="HttpEditorContextBar"
            IsVisible="{Binding Editor.IsHttpInterfaceEditor}">
      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="{StaticResource Space.3}">
        <!-- 视图切换是导航，放左侧与内容对齐（对标 Apifox 调试/设计/文档预览位置） -->
        <Border Grid.Column="0"
                Classes="HttpEditorModeBar">
          <StackPanel Orientation="Horizontal"
                      Spacing="{StaticResource Space.1}">
            <ToggleButton Classes="HttpEditorModeButton"
                          Command="{Binding Editor.ShowHttpDebugEditorModeCommand}"
                          Content="调试"
                          IsChecked="{Binding Editor.IsHttpDebugEditorMode, Mode=OneWay}" />
            <ToggleButton Classes="HttpEditorModeButton"
                          Command="{Binding Editor.ShowHttpDesignEditorModeCommand}"
                          Content="设计"
                          IsChecked="{Binding Editor.IsHttpDesignEditorMode, Mode=OneWay}" />
            <ToggleButton Classes="HttpEditorModeButton"
                          Command="{Binding Editor.ShowHttpDocumentPreviewModeCommand}"
                          Content="文档预览"
                          IsChecked="{Binding Editor.IsHttpDocumentPreviewMode, Mode=OneWay}" />
          </StackPanel>
        </Border>
        <TextBox Grid.Column="1"
                 Classes="SectionInput HttpInterfaceNameInput HttpEditorTitleInput"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"
                 PlaceholderText="未命名接口"
                 Text="{Binding Editor.CurrentHttpInterfaceName}" />
        <Button Grid.Column="2"
                Classes="IconButton HttpCodeIconButton"
                VerticalAlignment="Center"
                Command="{Binding Editor.OpenRequestCodeDialogCommand}"
                ToolTip.Tip="生成代码">
          <TextBlock Classes="HttpCodeIconGlyph"
                     Text="&lt;/&gt;" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          MinHeight="0"
          ClipToBounds="True">
      <!-- 工作台惰性实例化：首次显示才创建，纯快捷请求会话不再构造重量级 HTTP 工作台 -->
      <ContentControl x:Name="QuickRequestWorkbenchHost" IsVisible="{Binding Editor.IsQuickRequestEditor}" />
      <ContentControl x:Name="HttpWorkbenchHost" IsVisible="{Binding Editor.ShowHttpWorkbenchContent}" />
      <ContentControl x:Name="HttpDocumentHost" IsVisible="{Binding Editor.ShowHttpDocumentPreviewContent}" />
    </Grid>

  </Grid>
</UserControl>
