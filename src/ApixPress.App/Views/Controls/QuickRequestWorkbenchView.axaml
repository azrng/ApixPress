<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iri="https://irihi.tech/shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:ApixPress.App.ViewModels"
             xmlns:views="using:ApixPress.App.Views.Controls"
             x:Class="ApixPress.App.Views.Controls.QuickRequestWorkbenchView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowSpacing="0"
        MinHeight="0"
        ClipToBounds="True"
        IsVisible="{Binding Summary.IsQuickRequestEditor}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"
                     MinHeight="170"
                     MaxHeight="{Binding ConfigTab.ConfigPanelMaxHeight}" />
      <RowDefinition Height="6" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- 对齐原型：URL 行、Params/Body/Headers 子标签与参数表格同属一张配置卡片 -->
    <Border Grid.Row="0"
            Classes="PanelCard ProjectWorkspaceSettingsCard HttpWorkbenchConfigCard"
            Padding="0"
            MinHeight="170"
            MaxHeight="{Binding ConfigTab.ConfigPanelMaxHeight}">
      <Grid RowDefinitions="Auto,*">
        <views:HttpRequestUrlRowView Grid.Row="0" />
        <TabControl Grid.Row="1"
                    Classes="ConfigTabControl HttpRequestTabs"
                    SelectedIndex="{Binding ConfigTab.SelectedTabIndex}">
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.1}">
                <TextBlock Text="Params" />
                <u:Badge Header="{Binding ConfigTab.QueryParameterCountText}"
                         IsVisible="{Binding ConfigTab.HasQueryParameters}" />
              </StackPanel>
            </TabItem.Header>
            <views:HttpInterfaceParamsTabView />
          </TabItem>

          <TabItem Header="Body">
            <views:HttpInterfaceBodyTabView />
          </TabItem>

          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.1}">
                <TextBlock Text="Headers" />
                <u:Badge Header="{Binding ConfigTab.HeaderCountText}"
                         IsVisible="{Binding ConfigTab.HasHeaders}" />
              </StackPanel>
            </TabItem.Header>
            <views:HttpInterfaceHeadersTabView />
          </TabItem>
        </TabControl>
      </Grid>
    </Border>

    <GridSplitter Grid.Row="1"
                  Classes="HttpWorkbenchSplitter"
                  ResizeDirection="Rows"
                  HorizontalAlignment="Stretch" />

    <Border Grid.Row="2"
            Classes="PanelCard HttpResponseCard">
      <!-- 响应区右键：复制响应 Body / Headers / cURL（DataContext 即 ProjectTabViewModel，纯路径绑定） -->
      <Border.ContextMenu>
        <ContextMenu Classes="WorkspaceTabContextMenu">
          <MenuItem Classes="WorkspaceTabContextMenuItem"
                    Header="复制响应 Body"
                    Command="{Binding Editor.CopyResponseBodyCommand}"
                    CommandParameter="{Binding ResponseSection}">
            <MenuItem.Icon>
              <TextBlock Classes="WorkspaceTabContextMenuIcon"
                         Text="&#xE7C3;" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Classes="WorkspaceTabContextMenuItem"
                    Header="复制 Headers"
                    Command="{Binding Editor.CopyResponseHeadersCommand}"
                    CommandParameter="{Binding ResponseSection}">
            <MenuItem.Icon>
              <TextBlock Classes="WorkspaceTabContextMenuIcon"
                         Text="&#xE8FD;" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Classes="WorkspaceTabContextMenuItem"
                    Header="复制 cURL"
                    Command="{Binding Editor.CopyCurrentRequestCurlCommand}">
            <MenuItem.Icon>
              <TextBlock Classes="WorkspaceTabContextMenuIcon"
                         Text="&#xE756;" />
            </MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </Border.ContextMenu>
      <Grid RowDefinitions="Auto,Auto,*"
            RowSpacing="{StaticResource Space.2}">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="{StaticResource Space.3}">
          <TextBlock Grid.Column="0"
                     Classes="SectionTitle"
                     Text="返回响应" />
          <Grid Grid.Column="2"
                ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="{StaticResource Space.2}"
                HorizontalAlignment="Right"
                IsVisible="{Binding ResponseSection.HasResponse}">
            <TextBox Grid.Column="0"
                     Classes="SectionInput HttpResponseSearchInput"
                     PlaceholderText="搜索响应"
                     Text="{Binding ResponseSection.BodySearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1"
                       Classes="CaptionText"
                       VerticalAlignment="Center"
                       Text="{Binding ResponseSection.BodySearchResultText}" />
            <u:Badge Grid.Column="2"
                     Header="{Binding ResponseSection.StatusText}"
                     iri:ClassHelper.Classes="{Binding ResponseSection.StatusBadgeClass}" />
            <TextBlock Grid.Column="3"
                       Classes="CaptionText"
                       VerticalAlignment="Center"
                       Text="{Binding ResponseSection.DurationText}" />
            <TextBlock Grid.Column="4"
                       Classes="CaptionText"
                       VerticalAlignment="Center"
                       Text="{Binding ResponseSection.SizeText}" />
            <!-- 响应复制菜单：DataContext 路径绑定（MenuFlyout 内 $parent 查找会断链，禁止使用） -->
            <Button Grid.Column="5"
                    Classes="HttpResponseCopyButton"
                    ToolTip.Tip="复制响应内容">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         Text="&#xE8C8;" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="复制响应 Body"
                            Command="{Binding Editor.CopyResponseBodyCommand}"
                            CommandParameter="{Binding ResponseSection}">
                    <MenuItem.Icon>
                      <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 Text="&#xE7C3;" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="复制 Headers"
                            Command="{Binding Editor.CopyResponseHeadersCommand}"
                            CommandParameter="{Binding ResponseSection}">
                    <MenuItem.Icon>
                      <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 Text="&#xE8FD;" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="复制 cURL"
                            Command="{Binding Editor.CopyCurrentRequestCurlCommand}">
                    <MenuItem.Icon>
                      <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 Text="&#xE756;" />
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Grid>

        <!-- 响应状态提示横幅：独占一行，按严重度着色左侧色条；失败/5xx 提供一键重试，错误文本可选中复制 -->
        <Border Grid.Row="1"
                Classes="HttpResponseNoticeCard HttpResponseNoticeBanner"
                Classes.HttpResponseNoticeDanger="{Binding ResponseSection.IsNoticeDanger}"
                Classes.HttpResponseNoticeWarning="{Binding ResponseSection.IsNoticeWarning}"
                IsVisible="{Binding ResponseSection.ShowResponseNotice}">
          <StackPanel Orientation="Horizontal"
                      Spacing="{StaticResource Space.2}">
            <TextBlock Classes="HttpResponseNoticeTitle"
                       Text="{Binding ResponseSection.ResponseNoticeTitle}" />
            <SelectableTextBlock Classes="CaptionText HttpResponseNoticeText"
                                 VerticalAlignment="Center"
                                 Text="{Binding ResponseSection.ResponseNoticeText}"
                                 TextTrimming="CharacterEllipsis" />
            <Button Classes="HttpResponseNoticeRetryButton"
                    Content="重试"
                    IsVisible="{Binding ResponseSection.CanRetryRequest}"
                    Command="{Binding SendRequestCommand}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Classes="HttpResponsePlaceholderHost"
                IsVisible="{Binding ResponseSection.ShowPlaceholder}">
          <Border Classes="HttpResponsePlaceholderCard">
            <StackPanel Classes="HttpResponsePlaceholderContent"
                        Spacing="{StaticResource Space.3}">
              <Border Classes="HttpResponsePlaceholderIcon">
                <PathIcon Data="{StaticResource SemiIconCloudStroked}"
                          Width="26"
                          Height="26" />
              </Border>
              <TextBlock Classes="HttpResponsePlaceholderTitle"
                         Text="点击“发送”按钮获取返回结果" />
              <TextBlock Classes="SubtleText HttpResponsePlaceholderText"
                         Text="支持查看 Body 与 Headers、搜索响应内容、自动格式化 JSON" />
            </StackPanel>
          </Border>
        </Border>

        <Grid Grid.Row="2"
              IsVisible="{Binding ResponseSection.HasResponse}"
              RowDefinitions="*">
          <TabControl Grid.Row="0"
                      Classes="ResponseTabs"
                      SelectedIndex="{Binding ResponseSection.SelectedResponseTab}">
            <TabItem Header="Body">
              <Border Classes="HttpResponseBodyCard"
                      Margin="{StaticResource Pad.Top2}">
                <!-- AvaloniaEdit 只读查看器：大响应仅排版可视区，替代整页 Run 构建的 SelectableTextBlock -->
                <views:ResponseBodyEditor Text="{Binding ResponseSection.BodyText}" />
              </Border>
            </TabItem>
            <TabItem Header="Headers">
              <Border Classes="HttpResponseBodyCard"
                      Margin="{StaticResource Pad.Top2}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                  <SelectableTextBlock Classes="HttpResponseBodyViewer"
                             Text="{Binding ResponseSection.HeadersText}" />
                </ScrollViewer>
              </Border>
            </TabItem>
            <TabItem Header="实际请求">
              <views:ActualRequestPanelView DataContext="{Binding ResponseSection}" />
            </TabItem>
          </TabControl>
        </Grid>

        <Border Grid.Row="2"
                Classes="HttpResponseLoadingOverlay"
                IsVisible="{Binding ResponseSection.IsLoading}">
          <StackPanel Classes="HttpResponseLoadingContent"
                      Spacing="{StaticResource Space.3}">
            <ProgressBar Classes="HttpResponseLoadingProgress"
                         IsIndeterminate="True" />
            <TextBlock Classes="SubtleText HttpResponseLoadingText"
                       Text="{Binding ResponseSection.LoadingText}" />
            <Button Classes="DialogSecondaryButton HttpResponseCancelButton"
                    HorizontalAlignment="Center"
                    Content="取消请求"
                    Command="{Binding CancelRequestCommand}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
