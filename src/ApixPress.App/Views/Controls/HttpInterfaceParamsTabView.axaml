<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:views="using:ApixPress.App.Views.Controls"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.HttpInterfaceParamsTabView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <Grid Margin="{StaticResource Pad.TabSheet}" RowDefinitions="*">
    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="{StaticResource Space.3}">
        <Border Classes="HttpConfigSectionBar">
          <StackPanel Spacing="{StaticResource Space.1}">
            <TextBlock Classes="HttpConfigSectionLabel" Text="Path 参数" />
            <TextBlock Classes="CaptionText" Text="从 URL 路径模板自动提取；每个值会作为单独路径段编码。" />
          </StackPanel>
        </Border>

        <Border Classes="HttpConfigTableSurface">
          <Grid RowDefinitions="Auto,Auto">
            <Border Grid.Row="0" Classes="HttpConfigTableHeader">
              <Grid ColumnDefinitions="2*,3*" ColumnSpacing="{StaticResource Space.3}">
                <TextBlock Grid.Column="0" Classes="CaptionText" Text="参数名" />
                <TextBlock Grid.Column="1" Classes="CaptionText" Text="参数值" />
              </Grid>
            </Border>
            <Grid Grid.Row="1">
              <ItemsControl ItemsSource="{Binding ConfigTab.PathParameters}"
                            IsVisible="{Binding ConfigTab.HasPathParameters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RequestParameterItemViewModel">
                    <Border Classes="ParameterRow HttpConfigTableRow">
                      <Grid ColumnDefinitions="2*,3*" ColumnSpacing="{StaticResource Space.3}">
                        <TextBlock Grid.Column="0"
                                   Classes="CaptionText"
                                   VerticalAlignment="Center"
                                   Text="{Binding Name}" />
                        <TextBox Grid.Column="1"
                                 Classes="ParameterInput HttpTableInput"
                                 Classes.PathParameterInvalid="{Binding IsRequiredPathValueMissing}"
                                 views:ValidationFocusBehavior.HasError="{Binding IsRequiredPathValueMissing}"
                                 AutomationProperties.Name="{Binding Name, StringFormat='{}{0} 路径参数值'}"
                                 Text="{Binding Value, Mode=TwoWay}"
                                 PlaceholderText="输入路径参数值" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="HttpConfigEmptyState"
                      IsVisible="{Binding ConfigTab.ShowPathParametersEmptyState}">
                <TextBlock Classes="CaptionText" Text="URL 中没有路径参数" />
              </Border>
            </Grid>
          </Grid>
        </Border>

        <TextBlock Classes="PathParameterValidationText"
                   Text="{Binding ConfigTab.PathParameterValidationMessage}"
                   IsVisible="{Binding ConfigTab.HasPathParameterValidationMessage}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
