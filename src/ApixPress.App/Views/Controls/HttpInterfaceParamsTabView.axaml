<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.HttpInterfaceParamsTabView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <Grid Margin="{StaticResource Pad.TabSheet}"
        RowDefinitions="Auto,*"
        RowSpacing="{StaticResource Space.2}">
    <Border Grid.Row="0" Classes="HttpConfigSectionBar">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.3}">
        <StackPanel Spacing="{StaticResource Space.1}">
          <TextBlock Classes="HttpConfigSectionLabel" Text="Query 参数" />
          <TextBlock Classes="CaptionText" Text="追加到 URL；取消勾选的参数不会参与请求。" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="AddButton HttpConfigAddButton"
                Content="添加参数"
                Command="{Binding ConfigTab.AddQueryParameterCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="HttpConfigTableSurface">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="HttpConfigTableHeader">
          <Grid ColumnDefinitions="56,2.4*,2.8*,2.2*,44" ColumnSpacing="{StaticResource Space.3}">
            <CheckBox Grid.Column="0"
                      Content="启用"
                      IsThreeState="True"
                      IsChecked="{Binding ConfigTab.QueryParametersSelectionState, Mode=TwoWay}"
                      VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="CaptionText" Text="参数名" />
            <TextBlock Grid.Column="2" Classes="CaptionText" Text="参数值" />
            <TextBlock Grid.Column="3" Classes="CaptionText" Text="说明（可选）" />
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          
            <ListBox Classes="ParameterGridList" IsVisible="{Binding ConfigTab.HasQueryParameters}" ItemsSource="{Binding ConfigTab.QueryParameters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RequestParameterItemViewModel">
                  <Border Classes="ParameterRow HttpConfigTableRow">
                      <Grid ColumnDefinitions="56,2.4*,2.8*,2.2*,44" ColumnSpacing="{StaticResource Space.3}">
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="ParameterInput HttpTableInput" Text="{Binding Name}" PlaceholderText="例如：page" />
                      <TextBox Grid.Column="2" Classes="ParameterInput HttpTableInput" Text="{Binding Value}" PlaceholderText="例如：1 或 {{variable}}" />
                      <TextBox Grid.Column="3" Classes="ParameterInput HttpTableInput" Text="{Binding Description}" PlaceholderText="说明" />
                      <u:IconButton Grid.Column="4"
                                    Classes="Danger"
                                    Theme="{DynamicResource BorderlessIconButton}"
                                    Icon="{StaticResource SemiIconDelete}"
                                    Command="{Binding $parent[UserControl].((vm:ProjectTabViewModel)DataContext).ConfigTab.RemoveParameterCommand}"
                                    CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>

          <Border Classes="HttpConfigEmptyState"
                  IsVisible="{Binding ConfigTab.ShowQueryParametersEmptyState}">
            <TextBlock Classes="CaptionText" Text="尚未添加 Query 参数" />
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
