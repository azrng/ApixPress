<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.CreateProjectDialogView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <!-- 弹窗 chrome（遮罩/标题/关闭钮）由 Ursa StandardDialogControl 提供，内容只保留表单与按钮区 -->
  <Border Classes="CreateProjectDialogCard">
    <Grid RowDefinitions="Auto,Auto"
          RowSpacing="{StaticResource Space.4}">
      <!-- 表单：名称 + 备注，紧凑两行 -->
      <StackPanel Grid.Row="0"
                  Spacing="{StaticResource Space.3}">
        <StackPanel Spacing="6">
          <TextBlock Classes="CaptionText"
                     Text="项目名称" />
          <TextBox Classes="SectionInput DialogInput"
                   PlaceholderText="例如：订单中心"
                   Text="{Binding ProjectPanel.Creation.DraftProjectName}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="CaptionText"
                     Text="备注（可选）" />
          <TextBox Classes="SectionInput DialogInput"
                   AcceptsReturn="True"
                   MinHeight="64"
                   TextWrapping="Wrap"
                   PlaceholderText="简单描述这个项目的用途"
                   Text="{Binding ProjectPanel.Creation.DraftProjectDescription}" />
        </StackPanel>

        <TextBlock Classes="CaptionText"
                   Text="创建后会自动生成一个空的「开发」环境，并打开项目工作台。"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- 底部按钮 -->
      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="{StaticResource Space.2}">
        <Button Classes="DialogSecondaryButton"
                Content="取消"
                Command="{Binding CloseCreateProjectDialogCommand}" />
        <Button Classes="DialogPrimaryButton"
                Content="创建项目"
                Command="{Binding ProjectPanel.Creation.CreateProjectCommand}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
