<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iri="https://irihi.tech/shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:input="using:Avalonia.Input"
             xmlns:controls="using:ApixPress.App.Views.Controls"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.MainWindowHomeView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <ScrollViewer IsVisible="{Binding IsHomeTabActive}"
                HorizontalScrollBarVisibility="Disabled">
    <Grid Classes="HomeContentContainer"
          Margin="{StaticResource Pad.4}"
          RowDefinitions="Auto,*"
          RowSpacing="{StaticResource Space.3}">
        <Border Classes="HomeContentHeaderCard">
          <Grid RowDefinitions="Auto,Auto"
                RowSpacing="{StaticResource Space.2}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="{StaticResource Space.4}">
              <TextBlock Classes="PageTitle"
                         Text="项目首页"
                         VerticalAlignment="Center" />
              <TextBox Grid.Column="1"
                       Width="260"
                       Classes="ToolbarSearchBox"
                       PlaceholderText="搜索项目名称或备注"
                       VerticalAlignment="Center"
                       Text="{Binding ProjectPanel.SearchText}" />
              <Button Grid.Column="3"
                      Classes="PrimaryButton HomeCreateProjectButton"
                      Content="+ 新建项目"
                      HorizontalAlignment="Right"
                      Command="{Binding OpenCreateProjectDialogCommand}" />
            </Grid>
            <TextBlock Grid.Row="1"
                       Classes="CaptionText HomeSortErrorText"
                       Text="{Binding ProjectPanel.SortErrorMessage}"
                       IsVisible="{Binding ProjectPanel.HasSortError}" />
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="HomeContentBodyCard">
          <Grid>
            <Border Classes="HomeBodyEmptyCard"
                    IsVisible="{Binding ShowProjectListEmptyState}">
              <Border Classes="HomeBodyEmptySurface">
                <StackPanel Classes="HomeEmptyStack"
                            Spacing="{StaticResource Space.3}">
                  <Border Classes="HomeEmptyMedallion">
                    <!-- 对齐原型 01：白色描边「文件夹 + 加号」图标 -->
                    <Path Classes="HomeEmptyMedallionIcon"
                          Data="M3,7 A2,2 0 0 1 5,5 L9,5 L11.2,7.5 L19,7.5 A2,2 0 0 1 21,9.5 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z M12,10.8 L12,15.2 M9.8,13 L14.2,13" />
                  </Border>
                  <TextBlock Classes="HomeEmptyTitle"
                             Text="还没有项目" />
                  <TextBlock Classes="CaptionText HomeBodyEmptyDescription"
                             Text="创建第一个项目后，就可以在这里直接筛选、浏览并打开项目工作区。"
                             TextWrapping="Wrap" />
                  <Button Classes="PrimaryButton HomeCreateProjectButton"
                          Content="+ 新建项目"
                          HorizontalAlignment="Center"
                          Command="{Binding OpenCreateProjectDialogCommand}" />
                </StackPanel>
              </Border>
            </Border>

            <Border Classes="HomeBodyEmptyCard"
                    IsVisible="{Binding ShowProjectSearchEmptyState}">
              <Border Classes="HomeBodyEmptySurface">
                <StackPanel Classes="HomeEmptyStack"
                            Spacing="{StaticResource Space.3}">
                  <Border Classes="HomeEmptySearchMedallion">
                    <!-- 对齐原型 01：放大镜图标，搜索无结果用次级视觉层级 -->
                    <Path Classes="HomeEmptySearchIcon"
                          Data="M4.5,11 A6.5,6.5 0 1 0 17.5,11 A6.5,6.5 0 1 0 4.5,11 M15.6,15.6 L20,20" />
                  </Border>
                  <TextBlock Classes="HomeEmptyTitle HomeEmptySearchTitle"
                             Text="没有找到匹配项目" />
                  <TextBlock Classes="CaptionText HomeBodyEmptyDescription"
                             Text="可以换一个关键词继续搜索，或者直接新建一个项目。"
                             TextWrapping="Wrap" />
                  <Button Classes="SecondaryButton HomeCreateProjectButton"
                          Content="新建项目"
                          HorizontalAlignment="Center"
                          Command="{Binding OpenCreateProjectDialogCommand}" />
                </StackPanel>
              </Border>
            </Border>

            <ItemsControl ItemsSource="{Binding ProjectPanel.FilteredProjects}"
                          IsVisible="{Binding ProjectPanel.HasProjects}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:AdaptiveTilePanel MinItemWidth="250"
                                              ItemHeight="136"
                                              Gap="{StaticResource Space.3}"
                                              MaxColumns="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectWorkspaceItemViewModel">
                <Button Classes="HomeProjectTileButton"
                        ToolTip.Tip="打开项目"
                        input:DragDrop.AllowDrop="True"
                        input:DragDrop.DragOver="OnProjectTileDragOver"
                        input:DragDrop.DragLeave="OnProjectTileDragLeave"
                        input:DragDrop.Drop="OnProjectTileDrop"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProjectWorkspaceCommand}"
                        CommandParameter="{Binding}">
                  <!-- 右键菜单：打开项目 / 打开项目设置（注入式命令，跨 PopupRoot 绑定可用） -->
                  <Button.ContextMenu>
                    <ContextMenu Classes="WorkspaceTabContextMenu"
                                 DataContext="{Binding}">
                      <MenuItem Classes="WorkspaceTabContextMenuItem"
                                Header="打开项目"
                                Command="{Binding OpenProjectCommand}"
                                CommandParameter="{Binding}">
                        <MenuItem.Icon>
                          <TextBlock Classes="WorkspaceTabContextMenuIcon"
                                     Text="&#xE8E5;" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Classes="WorkspaceTabContextMenuItem"
                                Header="打开项目设置"
                                Command="{Binding OpenProjectSettingsCommand}"
                                CommandParameter="{Binding}">
                        <MenuItem.Icon>
                          <TextBlock Classes="WorkspaceTabContextMenuIcon"
                                     Text="&#xE713;" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Border Classes="HomeProjectTileCard">
                      <Grid Classes="HomeProjectTileContent"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="{StaticResource Space.3}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                              ColumnSpacing="{StaticResource Space.3}">
                          <Border Classes="HomeProjectTileIcon">
                            <TextBlock Classes="ProjectAvatarText"
                                       Text="{Binding AvatarText}" />
                          </Border>
                          <StackPanel Grid.Column="1"
                                      Spacing="4"
                                      VerticalAlignment="Center">
                            <TextBlock Classes="HomeProjectTileTitle"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <u:Badge Grid.Column="2"
                                   Header="默认"
                                   IsVisible="{Binding IsDefault}" />
                          <Border Grid.Column="3"
                                  Classes="HomeProjectDragHandle"
                                  IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ProjectPanel.CanReorderProjects}"
                                  ToolTip.Tip="拖拽调整项目顺序"
                                  PointerPressed="OnProjectDragHandlePointerPressed">
                            <Grid Classes="HomeProjectDragGrip"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,Auto"
                                  RowSpacing="{StaticResource Space.1}"
                                  ColumnSpacing="{StaticResource Space.1}">
                              <Ellipse Classes="HomeProjectDragGripDot" Grid.Row="0" Grid.Column="0" />
                              <Ellipse Classes="HomeProjectDragGripDot" Grid.Row="0" Grid.Column="1" />
                              <Ellipse Classes="HomeProjectDragGripDot" Grid.Row="1" Grid.Column="0" />
                              <Ellipse Classes="HomeProjectDragGripDot" Grid.Row="1" Grid.Column="1" />
                              <Ellipse Classes="HomeProjectDragGripDot" Grid.Row="2" Grid.Column="0" />
                              <Ellipse Classes="HomeProjectDragGripDot" Grid.Row="2" Grid.Column="1" />
                            </Grid>
                          </Border>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Classes="HomeProjectTileSummary"
                                   Text="{Binding Description}"
                                   ToolTip.Tip="{Binding Description}"
                                   IsVisible="{Binding HasDescription}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      
    </Grid>
  </ScrollViewer>
</UserControl>
