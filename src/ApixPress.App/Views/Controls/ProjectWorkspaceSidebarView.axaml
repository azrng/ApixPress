<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iri="https://irihi.tech/shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.ProjectWorkspaceSidebarView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <Border Classes="PanelCard ProjectWorkspaceSidebarCard">
    <Grid>
      <Grid IsVisible="{Binding Shell.IsInterfaceManagementSection}"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="{StaticResource Space.3}">
        <Grid ColumnDefinitions="*">
          <StackPanel Spacing="4">
            <TextBlock Classes="SectionTitle"
                       Text="接口管理" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource Space.2}">
          <TextBox Grid.Column="0"
                   Classes="ProjectSidebarSearchBox"
                   PlaceholderText="搜索"
                   Text="{Binding Catalog.InterfaceSearchText, Mode=TwoWay}">
            <TextBox.InnerLeftContent>
              <TextBlock Margin="10,0,2,0"
                         VerticalAlignment="Center"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         Foreground="{DynamicResource Brush.Text.Tertiary}"
                         Text="&#xE721;" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <Button Grid.Column="1"
                  Classes="ProjectSidebarAddButton"
                  Command="{Binding Workspace.OpenHttpInterfaceWorkspaceCommand}">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       Text="&#xE710;" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="2">
          <StackPanel Spacing="{StaticResource Space.3}">
            <Border Classes="ProjectSidebarSectionCard ProjectSidebarModuleSectionCard">
              <StackPanel Classes="ProjectSidebarModuleGroup">
                <StackPanel Classes="ProjectSidebarModuleChildren">
                  <Grid ColumnDefinitions="*,Auto">
                    <ToggleButton Grid.Column="0"
                                  x:Name="InterfaceCatalogToggle"
                                  Classes="ProjectSidebarCatalogToggleButton ProjectSidebarCatalogActiveButton ProjectSidebarCatalogFlatButton"
                                  IsChecked="{Binding Catalog.IsInterfaceCatalogExpanded, Mode=TwoWay}"
                                  Command="{Binding Catalog.OpenInterfaceRootCommand}">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                            ColumnSpacing="{StaticResource Space.2}">
                        <TextBlock Grid.Column="0"
                                   Classes="ProjectSidebarCatalogChevron"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   IsVisible="{Binding !#InterfaceCatalogToggle.IsChecked}"
                                   Text="&#xE76C;" />
                        <TextBlock Grid.Column="0"
                                   Classes="ProjectSidebarCatalogChevron"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   IsVisible="{Binding #InterfaceCatalogToggle.IsChecked}"
                                   Text="&#xE70D;" />
                        <TextBlock Grid.Column="1"
                                   Classes="WorkspaceTreeNodeGlyph"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Text="&#xE8C8;" />
                        <TextBlock Grid.Column="2"
                                   Classes="ProjectSidebarCatalogTitle"
                                   Text="接口" />
                      </Grid>
                    </ToggleButton>
                    <Button Grid.Column="1"
                            Classes="ProjectSidebarCatalogFlatButton"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="目录操作">
                      <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 Text="&#xE10C;" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="新建目录"
                                    Command="{Binding Catalog.RequestCreateFolderDialogCommand}">
                            <MenuItem.Icon>
                              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                         Text="&#xE8F4;" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="新建 HTTP 接口"
                                    Command="{Binding Workspace.OpenHttpInterfaceWorkspaceCommand}">
                            <MenuItem.Icon>
                              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                         Text="&#xE710;" />
                            </MenuItem.Icon>
                          </MenuItem>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>

                  <Border Classes="ProjectSidebarCatalogBody"
                          IsVisible="{Binding Catalog.IsInterfaceCatalogExpanded}">
                    <StackPanel Classes="ProjectSidebarCatalogContent">
                      <TextBlock Classes="CaptionText ProjectSidebarEmptyHint"
                                 Text="{Binding Catalog.InterfaceEmptyStateText}"
                                 IsVisible="{Binding Catalog.ShowInterfaceEntriesEmptyState}" />
                      <TreeView Classes="WorkspaceTreeView ProjectSidebarTree InterfaceSidebarTree"
                                ItemsSource="{Binding Catalog.InterfaceCatalogItems}">
                        <TreeView.ItemTemplate>
                          <TreeDataTemplate x:DataType="vm:ExplorerItemViewModel"
                                            ItemsSource="{Binding Children}">
                            <Button Classes="WorkspaceTreeNodeButton"
                                    IsHitTestVisible="{Binding IsClickable}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadSavedRequestCommand}"
                                    CommandParameter="{Binding}">
                            <Button.ContextMenu>
                              <ContextMenu DataContext="{Binding}">
                                <MenuItem Header="新建子目录"
                                          IsVisible="{Binding CanCreateSubfolder}"
                                          Command="{Binding CreateSubfolderCommand}"
                                          CommandParameter="{Binding FolderFullPath}" />
                                <MenuItem Header="新建 HTTP 接口"
                                          IsVisible="{Binding IsFolderNode}"
                                          Command="{Binding CreateInterfaceInFolderCommand}"
                                          CommandParameter="{Binding FolderFullPath}" />
                                <MenuItem Header="删除"
                                          IsEnabled="{Binding CanDelete}"
                                          Command="{Binding DeleteCommand}"
                                          CommandParameter="{Binding}" />
                              </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Spacing="1">
                              <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                    ColumnSpacing="2">
                                <TextBlock Grid.Column="0"
                                           Classes="WorkspaceTreeNodeGlyph"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Text="{Binding NodeGlyph}"
                                           IsVisible="{Binding ShowLeadingGlyph}" />
                                <TextBlock Grid.Column="0"
                                           Classes="WorkspaceTreeNodeGlyph WorkspaceTreeCaseGlyph"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Text="{Binding NodeGlyph}"
                                           IsVisible="{Binding IsHttpCaseNode}" />
                                <u:Badge Grid.Column="1"
                                         Margin="{StaticResource Pad.RightHalf}"
                                         Header="{Binding MethodBadgeText}"
                                         IsVisible="{Binding ShowMethodBadge}"
                                         iri:ClassHelper.Classes="{Binding MethodBadgeClass}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SidebarDisplayText}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           ToolTip.Tip="{Binding SidebarDisplayText}" />
                                <Border Grid.Column="3"
                                        Classes="WorkspaceTreeStatusDot"
                                        IsVisible="{Binding ShowTrailingDot}" />
                              </Grid>
                              <TextBlock Classes="CaptionText WorkspaceTreeSubtitleText"
                                         Text="{Binding Subtitle}"
                                         IsVisible="{Binding HasSubtitle}"
                                         TextTrimming="CharacterEllipsis"
                                         TextWrapping="NoWrap"
                                         ToolTip.Tip="{Binding Subtitle}" />
                            </StackPanel>
                            </Button>
                          </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                      </TreeView>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="ProjectSidebarSectionCard ProjectSidebarQuickSectionCard">
              <StackPanel Classes="ProjectSidebarTopLevelSection">
                <ToggleButton x:Name="QuickRequestCatalogToggle"
                              Classes="ProjectSidebarCatalogToggleButton ProjectSidebarCatalogFlatButton"
                              IsChecked="{Binding Catalog.IsQuickRequestCatalogExpanded, Mode=TwoWay}">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                        ColumnSpacing="{StaticResource Space.2}">
                    <TextBlock Grid.Column="0"
                               Classes="ProjectSidebarCatalogChevron"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               IsVisible="{Binding !#QuickRequestCatalogToggle.IsChecked}"
                               Text="&#xE76C;" />
                    <TextBlock Grid.Column="0"
                               Classes="ProjectSidebarCatalogChevron"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               IsVisible="{Binding #QuickRequestCatalogToggle.IsChecked}"
                               Text="&#xE70D;" />
                    <TextBlock Grid.Column="1"
                               Classes="WorkspaceTreeNodeGlyph"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Text="&#xE945;" />
                    <TextBlock Grid.Column="2"
                               Classes="ProjectSidebarSectionTitle"
                               Text="快捷请求" />
                  </Grid>
                </ToggleButton>
                <Border Classes="ProjectSidebarCatalogBody QuickRequestCatalogBody"
                        IsVisible="{Binding Catalog.IsQuickRequestCatalogExpanded}">
                  <StackPanel Classes="ProjectSidebarCatalogContent QuickRequestCatalogContent">
                    <TreeView Classes="WorkspaceTreeView ProjectSidebarTree QuickRequestSidebarTree"
                              ItemsSource="{Binding Catalog.QuickRequestTreeItems}">
                      <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="vm:ExplorerItemViewModel"
                                          ItemsSource="{Binding Children}">
                          <Button Classes="WorkspaceTreeNodeButton QuickRequestTreeNodeButton"
                                  IsHitTestVisible="{Binding CanLoad}"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadSavedRequestCommand}"
                                  CommandParameter="{Binding}">
                            <Button.ContextMenu>
                              <ContextMenu DataContext="{Binding}">
                                <MenuItem Header="删除"
                                          IsEnabled="{Binding CanDelete}"
                                          Command="{Binding DeleteCommand}"
                                          CommandParameter="{Binding}" />
                              </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Classes="QuickRequestTreeNodeContent">
                              <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                    ColumnSpacing="{StaticResource Space.1}">
                                <TextBlock Grid.Column="0"
                                           Classes="WorkspaceTreeNodeGlyph"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Text="{Binding NodeGlyph}"
                                           IsVisible="{Binding ShowLeadingGlyph}" />
                                <TextBlock Grid.Column="0"
                                           Classes="WorkspaceTreeNodeGlyph WorkspaceTreeCaseGlyph"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Text="{Binding NodeGlyph}"
                                           IsVisible="{Binding IsHttpCaseNode}" />
                                <u:Badge Grid.Column="1"
                                         Margin="{StaticResource Pad.Right1}"
                                         Header="{Binding MethodBadgeText}"
                                         IsVisible="{Binding ShowMethodBadge}"
                                         iri:ClassHelper.Classes="{Binding MethodBadgeClass}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DisplayTitle}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           ToolTip.Tip="{Binding DisplayTitle}" />
                                <Border Grid.Column="3"
                                        Classes="WorkspaceTreeStatusDot"
                                        IsVisible="{Binding ShowTrailingDot}" />
                              </Grid>
                              <TextBlock Classes="CaptionText WorkspaceTreeSubtitleText"
                                         Text="{Binding Subtitle}"
                                         IsVisible="{Binding HasSubtitle}"
                                         TextTrimming="CharacterEllipsis"
                                         TextWrapping="NoWrap"
                                         ToolTip.Tip="{Binding Subtitle}" />
                            </StackPanel>
                          </Button>
                        </TreeDataTemplate>
                      </TreeView.ItemTemplate>
                    </TreeView>
                    <Button Classes="ProjectSidebarGhostButton ProjectSidebarBottomCreateButton QuickRequestBottomCreateButton"
                            Content="+ 新建"
                            Command="{Binding Workspace.OpenQuickRequestWorkspaceCommand}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid IsVisible="{Binding Shell.IsRequestHistorySection}"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="{StaticResource Space.3}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource Space.2}">
          <StackPanel Spacing="2">
            <TextBlock Classes="SectionTitle"
                       Text="请求历史" />
            <TextBlock Classes="CaptionText"
                       Text="选择记录查看请求详情，并可继续发送。" />
          </StackPanel>
          <u:PopConfirm Grid.Column="1"
                        PopupHeader="确认清空当前项目的请求历史？"
                        PopupContent="清空后无法恢复。"
                        ConfirmCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearHistoryCommand}">
            <Button Classes="SecondaryButton"
                    Content="清空" />
          </u:PopConfirm>
        </Grid>

        <TextBox Grid.Row="1"
                 Classes="ProjectSidebarSearchBox"
                 PlaceholderText="搜索方法、URL 或状态码"
                 Text="{Binding HistoryPanel.SearchText, Mode=TwoWay}"
                 IsVisible="{Binding HistoryPanel.HasHistory}">
          <TextBox.InnerLeftContent>
            <TextBlock Margin="10,0,2,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                       Text="&#xE721;" />
          </TextBox.InnerLeftContent>
        </TextBox>

        <Grid Grid.Row="2">
          <TextBlock Classes="CaptionText"
                     Text="{Binding HistoryPanel.HistoryEmptyStateText}"
                     IsVisible="{Binding !HistoryPanel.HasVisibleHistory}" />
          <ListBox ItemsSource="{Binding RequestHistory}"
                   SelectedItem="{Binding HistoryPanel.SelectedHistoryItem, Mode=TwoWay}"
                   IsVisible="{Binding HistoryPanel.HasVisibleHistory}"
                   Classes="HistoryListBox">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RequestHistoryItemViewModel">
                <Border Classes="SidebarListCard HistoryListCard">
                  <StackPanel Spacing="{StaticResource Space.2}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{StaticResource Space.2}">
                      <u:Badge Grid.Column="0"
                               Header="{Binding Method}"
                               iri:ClassHelper.Classes="{Binding MethodBadgeClass}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Url}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="{StaticResource Space.2}">
                      <u:Badge Header="{Binding StatusText}"
                               iri:ClassHelper.Classes="{Binding StatusBadgeClass}" />
                      <TextBlock Grid.Column="1"
                                 Classes="CaptionText"
                                 Text="{Binding TimestampText}" />
                      <TextBlock Grid.Column="2"
                                 Classes="CaptionText"
                                 Text="{Binding DurationText}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
