<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApixPress.App.ViewModels"
             xmlns:views="using:ApixPress.App.Views.Controls"
             x:Class="ApixPress.App.Views.Controls.ProjectInterfaceRootWorkspaceView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <Border Classes="PanelCard ProjectWorkspaceCanvas"
          IsVisible="{Binding Shell.ShowInterfaceRootWorkspace}">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="{StaticResource Space.4}">
      <views:ProjectWorkspaceToolbarView />

      <Grid Grid.Row="1"
            RowDefinitions="Auto,*"
            RowSpacing="{StaticResource Space.4}"
            Margin="{StaticResource Pad.4}">
        <Grid ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="{StaticResource Space.3}">
          <Button Grid.Column="0"
                  Classes="InterfaceRootTabButton"
                  Classes.InterfaceRootTabButtonSelected="{Binding InterfaceRoot.IsAuthSelected}"
                  Command="{Binding InterfaceRoot.ShowAuthCommand}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.1}">
              <TextBlock Text="Auth" />
              <Border Classes="InterfaceRootAuthBadge">
                <TextBlock Text="{Binding InterfaceRoot.AuthBadgeText}" />
              </Border>
            </StackPanel>
          </Button>
          <Button Grid.Column="1"
                  Classes="InterfaceRootTabButton"
                  Classes.InterfaceRootTabButtonSelected="{Binding InterfaceRoot.IsAllInterfacesSelected}"
                  Command="{Binding InterfaceRoot.ShowAllInterfacesCommand}"
                  Content="全部接口" />
          <TextBlock Grid.Column="2"
                     Classes="CaptionText"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Text="{Binding InterfaceRoot.StatusText}" />
        </Grid>

        <Grid Grid.Row="1">
          <Border Classes="ProjectWorkspaceSettingsCard InterfaceRootAuthPanel"
                  IsVisible="{Binding InterfaceRoot.IsAuthSelected}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="{StaticResource Space.4}">
              <StackPanel Spacing="{StaticResource Space.1}">
                <TextBlock Classes="SectionTitle"
                           Text="HTTP 接口全局 Auth" />
                <TextBlock Classes="CaptionText"
                           Text="只对 HTTP 接口发送生效；具体接口已有 Authorization Header 时会优先使用具体接口配置。" />
              </StackPanel>

              <Grid Grid.Row="1"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="{StaticResource Space.2}">
                <TextBlock Classes="CaptionText"
                           Text="鉴权方式" />
                <ComboBox Grid.Row="1"
                          Classes="SectionInput"
                          ItemsSource="{Binding InterfaceRoot.AuthModes}"
                          SelectedIndex="{Binding InterfaceRoot.SelectedAuthModeIndex}" />
              </Grid>

              <Grid Grid.Row="2"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="{StaticResource Space.2}"
                    IsVisible="{Binding InterfaceRoot.IsBearerMode}">
                <TextBlock Classes="CaptionText"
                           Text="Bearer Token" />
                <TextBox Grid.Row="1"
                         Classes="SectionInput"
                         Watermark="例如 {{apiKey}}"
                         Text="{Binding InterfaceRoot.BearerToken}" />
              </Grid>

              <Grid Grid.Row="3"
                    ColumnDefinitions="*,Auto">
                <TextBlock Classes="CaptionText"
                           VerticalAlignment="Center"
                           Text="保存后，新发送的 HTTP 接口会自动应用该 Auth。" />
                <Button Grid.Column="1"
                        Classes="PrimaryButton"
                        Content="保存 Auth"
                        Command="{Binding InterfaceRoot.SaveAuthCommand}" />
              </Grid>
            </Grid>
          </Border>

          <Border Classes="ProjectWorkspaceSettingsCard InterfaceRootAllPanel"
                  IsVisible="{Binding InterfaceRoot.IsAllInterfacesSelected}">
            <Grid RowDefinitions="Auto,Auto,*"
                  RowSpacing="{StaticResource Space.3}">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="{StaticResource Space.3}">
                <StackPanel Spacing="{StaticResource Space.1}">
                  <TextBlock Classes="SectionTitle"
                             Text="{Binding InterfaceRoot.InterfaceCountText, StringFormat='根目录（接口 {0} 个）'}" />
                  <TextBlock Classes="CaptionText"
                             Text="查看当前项目全部 HTTP 接口，点击行可进入接口详情。" />
                </StackPanel>
                <TextBox Grid.Column="1"
                         Width="220"
                         Classes="SectionInput"
                         Watermark="搜索接口名称或路径"
                         Text="{Binding InterfaceRoot.SearchText}" />
              </Grid>

              <Border Grid.Row="1"
                      Classes="InterfaceRootTableHeader">
                <Grid ColumnDefinitions="36,2*,120,2*,180,110,140"
                      ColumnSpacing="{StaticResource Space.3}">
                  <TextBlock Grid.Column="1" Classes="CaptionText" Text="接口名称" />
                  <TextBlock Grid.Column="2" Classes="CaptionText" Text="请求类型" />
                  <TextBlock Grid.Column="3" Classes="CaptionText" Text="接口路径" />
                  <TextBlock Grid.Column="4" Classes="CaptionText" Text="接口分组" />
                  <TextBlock Grid.Column="5" Classes="CaptionText" Text="接口状态" />
                  <TextBlock Grid.Column="6" Classes="CaptionText" Text="标签" />
                </Grid>
              </Border>

              <Grid Grid.Row="2">
                <ScrollViewer IsVisible="{Binding InterfaceRoot.HasHttpInterfaces}">
                  <ItemsControl ItemsSource="{Binding InterfaceRoot.HttpInterfaces}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectHttpInterfaceOverviewItemViewModel">
                        <Button Classes="InterfaceRootTableRowButton"
                                Command="{Binding OpenCommand}">
                          <Grid ColumnDefinitions="36,2*,120,2*,180,110,140"
                                ColumnSpacing="{StaticResource Space.3}">
                            <CheckBox Grid.Column="0"
                                      IsHitTestVisible="False" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Classes="InterfaceRootMethodText"
                                       Classes.HttpMethodGet="{Binding IsGetMethod}"
                                       Classes.HttpMethodPost="{Binding IsPostMethod}"
                                       Classes.HttpMethodPut="{Binding IsPutMethod}"
                                       Classes.HttpMethodDelete="{Binding IsDeleteMethod}"
                                       Classes.HttpMethodPatch="{Binding IsPatchMethod}"
                                       Text="{Binding Method}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Path}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding GroupPath}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="5"
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource Space.1}">
                              <Border Classes="InterfaceRootStatusDot" />
                              <TextBlock Text="{Binding StatusText}" />
                            </StackPanel>
                            <Border Grid.Column="6"
                                    Classes="InterfaceRootTag">
                              <TextBlock Text="{Binding TagText}"
                                         TextTrimming="CharacterEllipsis" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <Border Classes="InterfaceRootEmptyState"
                        IsVisible="{Binding InterfaceRoot.ShowHttpInterfacesEmptyState}">
                  <StackPanel Spacing="{StaticResource Space.2}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <TextBlock Classes="SectionTitle"
                               Text="{Binding InterfaceRoot.HttpInterfacesEmptyText}" />
                    <TextBlock Classes="CaptionText"
                               Text="保存 HTTP 接口后会显示在这里。" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
