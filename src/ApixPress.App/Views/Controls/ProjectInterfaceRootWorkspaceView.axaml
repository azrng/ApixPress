<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:ApixPress.App.ViewModels"
             xmlns:views="using:ApixPress.App.Views.Controls"
             x:Class="ApixPress.App.Views.Controls.ProjectInterfaceRootWorkspaceView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <Grid RowDefinitions="*"
        MinHeight="0"
        ClipToBounds="True">
    <Grid RowDefinitions="Auto,*"
          Margin="{StaticResource Pad.InterfaceRootContent}">
        <Grid ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="{StaticResource Space.3}">
          <Button Grid.Column="0"
                  Classes="InterfaceRootTabButton"
                  Classes.InterfaceRootTabButtonSelected="{Binding InterfaceRoot.IsAuthSelected}"
                  Command="{Binding InterfaceRoot.ShowAuthCommand}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.1}">
              <TextBlock Text="Auth" />
              <u:Badge Header="{Binding InterfaceRoot.AuthBadgeText}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1"
                  Classes="InterfaceRootTabButton"
                  Classes.InterfaceRootTabButtonSelected="{Binding InterfaceRoot.IsAllInterfacesSelected}"
                  Command="{Binding InterfaceRoot.ShowAllInterfacesCommand}"
                  Content="全部接口" />
          <TextBlock Grid.Column="2"
                     Classes="CaptionText"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Text="{Binding InterfaceRoot.StatusText}" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="{StaticResource Pad.Top3}">
          <Border Classes="InterfaceRootWorkbenchSurface InterfaceRootAuthWorkbench"
                  IsVisible="{Binding InterfaceRoot.IsAuthSelected}">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid Classes="InterfaceRootWorkbenchHeader"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{StaticResource Space.3}">
                <StackPanel Spacing="{StaticResource Space.1}">
                  <TextBlock Classes="SectionTitle"
                             Text="HTTP 接口全局 Auth" />
                  <TextBlock Classes="CaptionText"
                             Text="配置根目录级默认鉴权；具体接口已有 Authorization Header 时优先使用接口配置。" />
                </StackPanel>
                <Border Grid.Column="1"
                        Classes="InterfaceRootAuthStatusPill">
                  <TextBlock Classes="CaptionText"
                             Text="{Binding InterfaceRoot.StatusText}" />
                </Border>
              </Grid>

              <Border Grid.Row="1"
                      Classes="InterfaceRootAuthBody">
                <Grid ColumnDefinitions="1.2*,*"
                      ColumnSpacing="{StaticResource Space.5}">
                  <Border Classes="InterfaceRootAuthFormPanel">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="{StaticResource Space.4}">
                      <Grid RowDefinitions="Auto,Auto"
                            RowSpacing="{StaticResource Space.2}">
                        <TextBlock Classes="CaptionText"
                                   Text="鉴权方式" />
                        <ComboBox Grid.Row="1"
                                  Classes="SectionInput"
                                  ItemsSource="{Binding InterfaceRoot.AuthModes}"
                                  SelectedIndex="{Binding InterfaceRoot.SelectedAuthModeIndex}" />
                      </Grid>

                      <Border Grid.Row="1"
                              Classes="InterfaceRootAuthModeNotice"
                              IsVisible="{Binding InterfaceRoot.IsNoAuthMode}">
                        <TextBlock Classes="CaptionText"
                                   Text="当前不会为请求自动追加 Authorization Header。" />
                      </Border>

                      <Grid Grid.Row="2"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="{StaticResource Space.2}"
                            IsVisible="{Binding InterfaceRoot.IsBearerMode}">
                        <TextBlock Classes="CaptionText"
                                   Text="Bearer Token" />
                        <TextBox Grid.Row="1"
                                 Classes="SectionInput"
                                 PlaceholderText="例如 {{apiKey}}"
                                 Text="{Binding InterfaceRoot.BearerToken}" />
                      </Grid>

                      <Grid Grid.Row="3"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="{StaticResource Space.2}"
                            IsVisible="{Binding InterfaceRoot.IsBasicMode}">
                        <TextBlock Classes="CaptionText"
                                   Text="用户名" />
                        <TextBox Grid.Row="1"
                                 Classes="SectionInput"
                                 PlaceholderText="Username"
                                 Text="{Binding InterfaceRoot.BasicUsername}" />
                        <TextBlock Grid.Row="2"
                                   Classes="CaptionText"
                                   Text="密码" />
                        <TextBox Grid.Row="3"
                                 Classes="SectionInput"
                                 PlaceholderText="Password"
                                 Text="{Binding InterfaceRoot.BasicPassword}" />
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1"
                          Classes="InterfaceRootAuthRulePanel">
                    <StackPanel Spacing="{StaticResource Space.3}">
                      <TextBlock Classes="SectionTitle"
                                 Text="生效规则" />
                      <TextBlock Classes="CaptionText"
                                 Text="只影响 HTTP 接口发送，不影响快捷请求、项目环境或历史记录。" />
                      <Border Classes="InterfaceRootAuthRuleItem">
                        <TextBlock Classes="CaptionText"
                                   Text="接口已启用 Authorization Header 时，优先使用接口自身配置。" />
                      </Border>
                      <Border Classes="InterfaceRootAuthRuleItem">
                        <TextBlock Classes="CaptionText"
                                   Text="Bearer Token 支持 {{变量}}，发送时按当前环境解析。" />
                      </Border>
                      <Border Classes="InterfaceRootAuthRuleItem">
                        <TextBlock Classes="CaptionText"
                                   Text="Basic Auth 保存用户名和密码，发送时生成 Basic Authorization 值。" />
                      </Border>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Border Grid.Row="2"
                      Classes="InterfaceRootAuthActionBar">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="CaptionText"
                             VerticalAlignment="Center"
                             Text="保存后，新发送的 HTTP 接口会自动应用该 Auth。" />
                  <Button Grid.Column="1"
                          Classes="PrimaryButton"
                          Content="保存 Auth"
                          Command="{Binding InterfaceRoot.SaveAuthCommand}" />
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Border Classes="InterfaceRootWorkbenchSurface"
                  IsVisible="{Binding InterfaceRoot.IsAllInterfacesSelected}">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid Classes="InterfaceRootWorkbenchHeader"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{StaticResource Space.3}">
                <StackPanel Spacing="{StaticResource Space.1}">
                  <TextBlock Classes="SectionTitle"
                             Text="{Binding InterfaceRoot.InterfaceCountText, StringFormat='根目录（接口 {0} 个）'}" />
                  <TextBlock Classes="CaptionText"
                             Text="查看当前项目全部 HTTP 接口，点击行可进入接口详情。" />
                </StackPanel>
                <TextBox Grid.Column="1"
                         Width="220"
                         Classes="SectionInput"
                         PlaceholderText="搜索接口名称或路径"
                         Text="{Binding InterfaceRoot.SearchText}" />
              </Grid>

              <Border Grid.Row="1"
                      Classes="InterfaceRootFilterBar">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                      ColumnSpacing="{StaticResource Space.2}">
                  <Border Classes="InterfaceRootFilterChip">
                    <TextBlock Classes="CaptionText"
                               Text="{Binding InterfaceRoot.InterfaceCountText, StringFormat='全部 {0}'}" />
                  </Border>
                  <Border Grid.Column="1"
                          Classes="InterfaceRootFilterChip">
                    <TextBlock Classes="CaptionText"
                               Text="HTTP 接口" />
                  </Border>
                  <TextBlock Grid.Column="4"
                             Classes="CaptionText"
                             VerticalAlignment="Center"
                             Text="点击行进入接口详情" />
                </Grid>
              </Border>

              <Border Grid.Row="2"
                      Classes="InterfaceRootTableSurface">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="InterfaceRootTableHeader">
                    <Grid ColumnDefinitions="32,2.2*,82,2.4*,1.5*,90,110"
                          ColumnSpacing="{StaticResource Space.3}">
                      <TextBlock Grid.Column="1" Classes="CaptionText" Text="接口名称" />
                      <TextBlock Grid.Column="2" Classes="CaptionText" Text="请求类型" />
                      <TextBlock Grid.Column="3" Classes="CaptionText" Text="接口路径" />
                      <TextBlock Grid.Column="4" Classes="CaptionText" Text="接口分组" />
                      <TextBlock Grid.Column="5" Classes="CaptionText" Text="接口状态" />
                      <TextBlock Grid.Column="6" Classes="CaptionText" Text="标签" />
                    </Grid>
                  </Border>

                  <Grid Grid.Row="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding InterfaceRoot.HasHttpInterfaces}">
                      <ItemsControl Classes="InterfaceRootTableRows"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding InterfaceRoot.HttpInterfaces}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProjectHttpInterfaceOverviewItemViewModel">
                            <Button Classes="InterfaceRootTableRowButton"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding OpenCommand}">
                              <Grid ColumnDefinitions="32,2.2*,82,2.4*,1.5*,90,110"
                                    ColumnSpacing="{StaticResource Space.3}">
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Classes="InterfaceRootMethodText"
                                           Classes.HttpMethodGet="{Binding IsGetMethod}"
                                           Classes.HttpMethodPost="{Binding IsPostMethod}"
                                           Classes.HttpMethodPut="{Binding IsPutMethod}"
                                           Classes.HttpMethodDelete="{Binding IsDeleteMethod}"
                                           Classes.HttpMethodPatch="{Binding IsPatchMethod}"
                                           Text="{Binding Method}" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Path}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4"
                                           Text="{Binding GroupPath}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="5"
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource Space.1}">
                                  <Border Classes="InterfaceRootStatusDot" />
                                  <TextBlock Text="{Binding StatusText}" />
                                </StackPanel>
                                <Border Grid.Column="6"
                                        Classes="InterfaceRootTag">
                                  <TextBlock Text="{Binding TagText}"
                                             TextTrimming="CharacterEllipsis" />
                                </Border>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <Border Classes="InterfaceRootEmptyState"
                            IsVisible="{Binding InterfaceRoot.ShowHttpInterfacesEmptyState}">
                      <StackPanel Spacing="{StaticResource Space.2}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                        <TextBlock Classes="SectionTitle"
                                   Text="{Binding InterfaceRoot.HttpInterfacesEmptyText}" />
                        <TextBlock Classes="CaptionText"
                                   Text="保存 HTTP 接口后会显示在这里。" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
    </Grid>
  </Grid>
</UserControl>
