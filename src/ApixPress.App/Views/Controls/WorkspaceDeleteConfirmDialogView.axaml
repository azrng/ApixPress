<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.WorkspaceDeleteConfirmDialogView"
             x:DataType="vm:ProjectWorkspaceCatalogViewModel"
             mc:Ignorable="d">
  <!-- 弹窗 chrome 由 Ursa StandardDialogControl 提供；DataContext 为目录 VM -->
  <Border Classes="DialogDangerCard">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="{StaticResource Space.3}">
      <StackPanel Spacing="2">
        <TextBlock Classes="DialogTitle DialogDangerText"
                   Text="该操作无法撤销" />
        <TextBlock Classes="CaptionText"
                   Text="{Binding PendingDeleteTitle, StringFormat='即将删除：{0}'}"
                   IsVisible="{Binding HasPendingDeleteTarget}" />
      </StackPanel>

      <TextBlock Grid.Row="1"
                 Text="{Binding PendingDeleteDescription}"
                 TextWrapping="Wrap" />

      <Border Grid.Row="2" Classes="DialogDangerNotice">
        <StackPanel Spacing="2">
          <TextBlock Classes="DialogDangerText" Text="该操作无法恢复" />
          <TextBlock Classes="CaptionText" Text="将同时删除其下的请求用例与调试配置。" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="3"
              Classes="DialogFooter">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{StaticResource Space.2}">
          <Button Classes="DialogSecondaryButton"
                  Content="取消"
                  Command="{Binding CancelDeleteCommand}" />
          <Button Classes="DialogDangerButton"
                  Content="确认删除"
                  Command="{Binding ConfirmDeleteCommand}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
