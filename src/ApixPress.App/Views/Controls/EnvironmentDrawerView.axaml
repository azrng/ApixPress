<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.EnvironmentDrawerView"
             x:DataType="vm:MainWindowViewModel"
             d:DesignWidth="520"
             d:DesignHeight="720"
             mc:Ignorable="d">
  <!-- 环境管理抽屉：多环境卡片平铺、同时编辑（对齐确认原型 07-environments：单一主 CTA、激活卡品牌分层、环境名标题式就地编辑） -->
  <!-- OverlayDrawer 测量内容时给无限宽（支持拖拽调宽），长文本会按单行固有宽撑开内容导致右侧被裁，这里显式约束内容最大宽度 -->
  <Grid RowDefinitions="Auto,*,Auto"
        RowSpacing="{StaticResource Space.3}"
        MaxWidth="520">

    <!-- 顶行：一行提示 + 新增环境（原型位于抽屉头部；Ursa 抽屉标题栏不放自定义按钮，保留内容区顶行） -->
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="{StaticResource Space.2}">
      <TextBlock Classes="CaptionText"
                 Text="点卡片任意处切换激活 · 发送时自动替换 {{变量名}} · 禁用变量不参与请求"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Classes="SecondaryButton"
              Content="＋ 新增环境"
              Command="{Binding EnvironmentPanel.AddEnvironmentCommand}" />
    </Grid>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding EnvironmentPanel.Environments}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{StaticResource Space.3}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectEnvironmentItemViewModel">
            <Border Classes="EnvironmentCard"
                    Classes.env-active="{Binding IsActive}">
              <Grid>
                <Button Classes="EnvironmentCardActivationSurface"
                        IsVisible="{Binding !IsActive}"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).EnvironmentPanel.SelectEnvironmentCommand}"
                        CommandParameter="{Binding}" />
                <StackPanel Spacing="{StaticResource Space.2}">

                  <!-- 头部：激活圆点 + 标题式环境名 + 激活徽章 / 设为激活 + 删除 -->
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                        ColumnSpacing="{StaticResource Space.2}">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="{StaticResource Space.2}">
                      <Border Classes="EnvActiveDot"
                              IsVisible="{Binding IsActive}"
                              VerticalAlignment="Center" />
                      <TextBox Classes="EnvironmentNameInput"
                               PlaceholderText="环境名称，例如 开发 / 测试 / 生产"
                               Text="{Binding Name}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Classes="EnvCardActiveChip"
                            IsVisible="{Binding IsActive}"
                            VerticalAlignment="Center">
                      <TextBlock Classes="EnvMenuActiveChipText" Text="当前激活" />
                    </Border>
                    <Button Grid.Column="2"
                            Classes="EnvCardGhostButton"
                            IsVisible="{Binding !IsActive}"
                            Content="设为激活"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).EnvironmentPanel.SelectEnvironmentCommand}"
                            CommandParameter="{Binding}" />
                    <u:PopConfirm Grid.Column="3"
                                  Placement="Left"
                                  PopupHeader="确认删除该环境？"
                                  PopupContent="若这是激活环境，系统会自动切换到其他环境。"
                                  ConfirmCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).EnvironmentPanel.RemoveEnvironmentCommand}"
                                  ConfirmCommandParameter="{Binding}">
                      <u:IconButton Classes="Danger"
                                    Theme="{DynamicResource BorderlessIconButton}"
                                    Icon="{StaticResource SemiIconDelete}"
                                    ToolTip.Tip="删除该环境" />
                    </u:PopConfirm>
                  </Grid>

                  <Grid ColumnDefinitions="56,*"
                        ColumnSpacing="{StaticResource Space.2}">
                    <TextBlock Text="BaseUrl"
                               Classes="CaptionText"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Classes="SectionInput"
                             PlaceholderText="例如 https://api.example.com"
                             Text="{Binding BaseUrl}" />
                  </Grid>

                  <!-- 变量小节头：计数与新增入口同行 -->
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="{StaticResource Space.2}">
                    <TextBlock Classes="CaptionText"
                               Text="{Binding VariableCountText}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="EnvCardGhostButton"
                            Content="＋ 新增变量"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).EnvironmentPanel.AddVariableCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Variables}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EnvironmentVariableItemViewModel">
                        <Grid Classes="EnvironmentVariableRow"
                              ColumnDefinitions="1.1*,1.4*,Auto,Auto"
                              ColumnSpacing="{StaticResource Space.2}">
                          <TextBox Classes="SectionInput"
                                   PlaceholderText="变量键，例如 token"
                                   Text="{Binding Key}" />
                          <TextBox Grid.Column="1"
                                   Classes="SectionInput"
                                   PlaceholderText="变量值"
                                   Text="{Binding Value}" />
                          <CheckBox Grid.Column="2"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsEnabled}"
                                    ToolTip.Tip="启用状态决定该变量是否参与请求" />
                          <u:PopConfirm Grid.Column="3"
                                        Placement="Left"
                                        PopupHeader="确认删除该环境变量？"
                                        PopupContent="删除后当前环境下对应的变量引用会立即失效。"
                                        ConfirmCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).EnvironmentPanel.RemoveVariableCommand}"
                                        ConfirmCommandParameter="{Binding}">
                            <u:IconButton Classes="Danger"
                                          Theme="{DynamicResource BorderlessIconButton}"
                                          Icon="{StaticResource SemiIconDelete}"
                                          ToolTip.Tip="删除该变量" />
                          </u:PopConfirm>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 卡尾：逐卡保存降为轻按钮（全局「保存全部环境」是唯一主按钮） -->
                  <Button Classes="EnvCardGhostButton"
                          Content="保存本环境"
                          HorizontalAlignment="Right"
                          Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).EnvironmentPanel.SaveEnvironmentCommand}"
                          CommandParameter="{Binding}" />

                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- 底栏：唯一实心主按钮 -->
    <Grid Grid.Row="2"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="{StaticResource Space.3}">
      <TextBlock Classes="CaptionText"
                 Text="未保存的修改关闭抽屉后仍保留在卡片中"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Classes="PrimaryButton"
              Content="保存全部环境"
              Command="{Binding EnvironmentPanel.SaveAllEnvironmentsCommand}" />
    </Grid>
  </Grid>
</UserControl>
