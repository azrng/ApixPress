<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.EnvironmentManagerDialogView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <!-- 弹窗 chrome 由 Ursa StandardDialogControl 提供；DataContext 为主窗口 VM，环境数据经 EnvironmentPanel 访问 -->
  <Border Classes="EnvDrawerPanel">
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- 头部：新增环境 -->
      <Border Classes="EnvDrawerHead">
        <Button Classes="EnvAddButton"
                HorizontalAlignment="Right"
                Content="&#xFF0B; 新增环境"
                Command="{Binding EnvironmentPanel.AddEnvironmentCommand}" />
      </Border>

      <!-- 环境卡片列表 -->
      <ScrollViewer Grid.Row="1"
                    Padding="16,12,16,0">
        <ItemsControl ItemsSource="{Binding EnvironmentPanel.Environments}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectEnvironmentItemViewModel">
              <Border Classes="EnvCard"
                      Classes.EnvCardActive="{Binding IsActive}"
                      Margin="0,0,0,10">
                <StackPanel Spacing="{StaticResource Space.2}">
                  <!-- 卡片头（点击切换选中/激活环境）：名称 + 激活标识 + BaseUrl -->
                  <Button Classes="EnvCardHeadButton"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EnvironmentPanel.SelectEnvironmentCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="{StaticResource Space.2}">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="{StaticResource Space.2}"
                                  VerticalAlignment="Center">
                        <TextBlock Classes="EnvCardName"
                                   Text="{Binding Name}" />
                        <Border Classes="EnvCardActiveChip"
                                IsVisible="{Binding IsActive}">
                          <TextBlock Classes="EnvCardActiveChipText"
                                     Text="激活" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Classes="EnvCardUrl"
                                 Text="{Binding DisplayBaseUrl}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1" />
                    </Grid>
                  </Button>

                  <!-- 选中卡片：名称 / BaseUrl / 变量编辑 -->
                  <StackPanel IsVisible="{Binding IsSelected}"
                              Spacing="{StaticResource Space.2}">
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="{StaticResource Space.2}">
                      <TextBox Grid.Column="0"
                               Classes="SectionInput EnvCellInput"
                               PlaceholderText="环境名称"
                               Text="{Binding Name}" />
                      <TextBox Grid.Column="1"
                               Classes="SectionInput EnvCellInput EnvMonoInput"
                               PlaceholderText="BaseUrl，例如 https://api.example.com"
                               Text="{Binding BaseUrl}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EnvironmentPanel.EnvironmentVariables}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EnvironmentVariableItemViewModel">
                          <Grid ColumnDefinitions="1.1*,1.4*,Auto,26"
                                ColumnSpacing="{StaticResource Space.2}"
                                Margin="0,0,0,6">
                            <TextBox Classes="EnvCellInput EnvMonoInput"
                                     PlaceholderText="Key"
                                     Text="{Binding Key}" />
                            <TextBox Grid.Column="1"
                                     Classes="EnvCellInput EnvMonoInput"
                                     PlaceholderText="Value"
                                     Text="{Binding Value}" />
                            <CheckBox Grid.Column="2"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="是否参与请求"
                                      IsChecked="{Binding IsEnabled}" />
                            <Button Grid.Column="3"
                                    Classes="EnvVarDeleteButton"
                                    ToolTip.Tip="删除该变量"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EnvironmentPanel.RemoveVariableCommand}"
                                    CommandParameter="{Binding}"
                                    Content="&#xE74D;" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="CaptionText"
                                 VerticalAlignment="Center"
                                 Text="发送时自动替换 {{变量名}}；启用状态决定该变量是否参与请求。" />
                      <Button Grid.Column="1"
                              Classes="EnvAddButton"
                              Height="26"
                              Padding="10,0"
                              Content="&#xFF0B; 新增变量"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EnvironmentPanel.AddVariableCommand}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 底部：内联删除确认条 + 动作 -->
      <StackPanel Grid.Row="2"
                  Spacing="{StaticResource Space.2}"
                  Margin="16,12,16,14">
        <Border Classes="EnvDeleteStrip"
                IsVisible="{Binding EnvironmentPanel.IsRemoveEnvironmentConfirmOpen}">
          <StackPanel Spacing="{StaticResource Space.2}">
            <TextBlock Classes="CaptionText"
                       TextWrapping="Wrap"
                       Text="{Binding EnvironmentPanel.SelectedEnvironment.Name, StringFormat='删除「{0}」环境？若这是激活环境，系统会自动切换到其他环境。'}" />
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.2}">
              <Button Classes="EnvDeleteStripConfirm"
                      Content="确认删除"
                      Command="{Binding EnvironmentPanel.RemoveEnvironmentCommand}" />
              <Button Classes="DialogSecondaryButton EnvDeleteStripCancel"
                      Content="取消"
                      Command="{Binding EnvironmentPanel.CancelRemoveEnvironmentCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource Space.2}">
          <Button Classes="DialogPrimaryButton"
                  HorizontalAlignment="Stretch"
                  Content="保存环境"
                  Command="{Binding SaveEnvironmentManagerCommand}" />
          <Button Grid.Column="1"
                  Classes="HttpCancelButton EnvDrawerDeleteButton"
                  Padding="12,7"
                  Content="删除环境"
                  Command="{Binding EnvironmentPanel.RequestRemoveEnvironmentCommand}" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
