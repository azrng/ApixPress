<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.ProjectWorkspaceToolbarView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <!-- 项目内请求标签已迁移到标题栏下方的 ProjectInnerTabBarView；标题栏只保留环境芯片 -->
  <Border Classes="ProjectWorkspaceTopActionBar">
    <Button x:Name="EnvironmentChipButton"
            Classes="EnvChipButton"
            VerticalAlignment="Center"
            ToolTip.Tip="切换环境">
      <StackPanel Orientation="Horizontal"
                  Spacing="7">
        <Ellipse Width="7"
                 Height="7"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource Brush.Status.Success.Text}" />
        <TextBlock VerticalAlignment="Center"
                   Text="{Binding EnvironmentPanel.EnvironmentChipText}" />
        <TextBlock Classes="EnvChipCaret"
                   VerticalAlignment="Center"
                   Text="&#xE70D;" />
      </StackPanel>
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight"
                ShowMode="Transient">
          <Border Classes="EnvMenuCard">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding EnvironmentPanel.Environments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectEnvironmentItemViewModel">
                    <Button Classes="EnvMenuItem"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="OnEnvironmentMenuItemClick"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActiveProjectTab.EnvironmentPanel.SelectEnvironmentCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="8">
                        <TextBlock Classes="EnvMenuCheck"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsActive}"
                                   Text="&#x2713;" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2"
                                Classes="EnvMenuActiveChip"
                                IsVisible="{Binding IsActive}">
                          <TextBlock Classes="EnvMenuActiveChipText"
                                     Text="激活" />
                        </Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Separator Classes="EnvMenuSeparator" Margin="0,4,0,0" />
              <Button Classes="EnvMenuFootButton"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Click="OnEnvironmentManagerFromChipClick"
                      Content="管理环境…" />
            </StackPanel>
          </Border>
        </Flyout>
      </Button.Flyout>
    </Button>
  </Border>
</UserControl>
