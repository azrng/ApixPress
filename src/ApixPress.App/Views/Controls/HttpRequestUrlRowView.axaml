<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iri="https://irihi.tech/shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.HttpRequestUrlRowView"
             x:DataType="vm:ProjectTabViewModel"
             mc:Ignorable="d">
  <!-- 请求动作行：方法 + BaseUrl + 路径 + 发送/发送中 + 取消 + 用例入口 + 保存分裂按钮 -->
  <Grid Classes="HttpRequestUrlRow"
        ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
        ColumnSpacing="{StaticResource Space.2}">
    <Border Grid.Column="0"
            Classes="HttpRequestUrlShell">
      <Grid ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="{StaticResource Space.1}">
        <ComboBox Grid.Column="0"
                  Classes="HttpMethodSelector"
                  iri:ClassHelper.Classes="{Binding Editor.MethodColorClass}"
                  ItemsSource="{Binding Editor.HttpMethods}"
                  SelectedItem="{Binding Editor.SelectedMethod}" />
        <Border Grid.Column="1"
                Classes="BaseUrlPrefixCard HttpBaseUrlPrefixCard">
          <TextBlock Classes="HttpBaseUrlPrefixText"
                     Text="{Binding Editor.CurrentEditorBaseUrlCaption}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Border>
        <TextBox Grid.Column="2"
                 Classes="HttpRequestPathInput"
                 PlaceholderText="{Binding Editor.CurrentEditorUrlWatermark}"
                 Text="{Binding Editor.RequestUrl}" />
      </Grid>
    </Border>

    <!-- 发送：发送中切换为 spinner + 文案并禁用（对齐原型 btn-primary.loading） -->
    <Button Grid.Column="1"
            Classes="HttpSendButton"
            MinWidth="96"
            Command="{Binding SendRequestCommand}"
            IsEnabled="{Binding !ResponseSection.IsLoading}">
      <StackPanel Orientation="Horizontal"
                  Spacing="7">
        <Path Classes="HttpSpinner"
              Width="14"
              Height="14"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding ResponseSection.IsLoading}" />
        <TextBlock VerticalAlignment="Center"
                   IsVisible="{Binding ResponseSection.IsLoading}"
                   Text="发送中…" />
        <TextBlock VerticalAlignment="Center"
                   IsVisible="{Binding !ResponseSection.IsLoading}"
                   Text="发送" />
      </StackPanel>
    </Button>

    <!-- 发送中的取消入口（对齐原型 URL 行取消按钮） -->
    <Button Grid.Column="2"
            Classes="HttpCancelButton"
            MinWidth="70"
            IsVisible="{Binding ResponseSection.IsLoading}"
            Command="{Binding CancelRequestCommand}"
            Content="取消" />

    <!-- 用例动作与请求动作之间用分隔线区分归属 -->
    <Border Grid.Column="3"
            Width="1"
            Height="22"
            Background="{DynamicResource Brush.Border.Default}"
            IsVisible="{Binding Editor.ShowSaveHttpCaseAction}" />
    <Button Grid.Column="4"
            Classes="HttpCancelButton HttpUseCasesButton"
            Padding="12,7"
            MinWidth="0"
            Content="用例"
            IsVisible="{Binding Editor.ShowSaveHttpCaseAction}"
            ToolTip.Tip="管理该接口的用例"
            Click="OnOpenUseCasesClick" />
    <!-- 保存分裂按钮：主操作保存接口，caret 菜单提供保存为用例 -->
    <Grid Grid.Column="5"
          Classes="HttpSaveSplit"
          IsVisible="{Binding !ResponseSection.IsLoading}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Classes="HttpSaveButton HttpSaveSplitMain"
              MinWidth="70"
              Content="保存"
              Command="{Binding SaveCaseCommand}" />
      <Button x:Name="HttpSaveSplitCaretButton"
              Grid.Column="1"
              Classes="HttpSaveButton HttpSaveSplitCaret"
              Content="&#xE70D;"
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
              FontSize="10"
              ToolTip.Tip="更多保存方式"
              Click="OnCaretButtonClick">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight"
                  ShowMode="Transient">
            <Border Classes="HttpSplitMenuCard">
              <StackPanel>
                <Button Classes="HttpSplitMenuItem"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Content="保存为用例"
                        Command="{Binding #HttpSaveSplitCaretButton.DataContext.SaveHttpCaseCommand}"
                        IsVisible="{Binding #HttpSaveSplitCaretButton.DataContext.Editor.ShowSaveHttpCaseAction}" />
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>
  </Grid>
</UserControl>
