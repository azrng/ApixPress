<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ApixPress.App.ViewModels"
             x:Class="ApixPress.App.Views.Controls.ProjectImportDialogView"
             x:DataType="vm:ProjectImportViewModel"
             mc:Ignorable="d">
  <!-- 弹窗 chrome 由 Ursa StandardDialogControl 提供；DataContext 为导入 VM -->
  <Border Classes="ProjectImportDialogCard">
    <Grid>
      <Grid RowDefinitions="Auto,Auto,Auto,*"
            RowSpacing="{StaticResource Space.3}"
            IsEnabled="{Binding CanEditImportData}">
        <Border Grid.Row="0"
                Classes="ProjectImportDialogHeaderCard">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="{StaticResource Space.3}">
            <Border Width="44"
                    Height="44"
                    Classes="ProjectImportFormatIcon">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="{StaticResource Font.Size.BodyLarge}"
                         FontWeight="Bold"
                         Text="S" />
            </Border>
            <StackPanel Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
              <TextBlock Classes="CaptionText"
                         Text="{Binding DialogFormatLabel}" />
              <TextBlock Text="{Binding DialogFormatName}"
                         FontSize="{StaticResource Font.Size.BodyLarge}"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="ProjectImportDialogNoticeCard">
          <TextBlock Text="{Binding DialogNoticeText}"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
        </Border>

        <StackPanel Grid.Row="2"
                    Spacing="{StaticResource Space.3}">
          <Border Classes="ProjectImportTabStrip">
            <Grid ColumnDefinitions="*,*">
              <ToggleButton Grid.Column="0"
                            Classes="ProjectImportModeTab"
                            Command="{Binding ShowImportFileModeCommand}"
                            IsChecked="{Binding IsImportFileMode, Mode=OneWay}">
                <TextBlock Text="{Binding FileModeTitle}" />
              </ToggleButton>
              <ToggleButton Grid.Column="1"
                            Classes="ProjectImportModeTab"
                            Command="{Binding ShowImportUrlModeCommand}"
                            IsChecked="{Binding IsImportUrlMode, Mode=OneWay}">
                <TextBlock Text="{Binding UrlModeTitle}" />
              </ToggleButton>
            </Grid>
          </Border>

          <Border Classes="StatusInfo"
                  IsVisible="{Binding ShowImportStatusInfo}">
            <TextBlock Text="{Binding ImportDataStatusText}"
                       TextWrapping="Wrap" />
          </Border>
          <Border Classes="StatusSuccess"
                  IsVisible="{Binding ShowImportStatusSuccess}">
            <TextBlock Text="{Binding ImportDataStatusText}"
                       TextWrapping="Wrap" />
          </Border>
          <Border Classes="StatusError"
                  IsVisible="{Binding ShowImportStatusError}">
            <TextBlock Text="{Binding ImportDataStatusText}"
                       TextWrapping="Wrap" />
          </Border>

          <Border Classes="ProjectImportDropZoneCard"
                  IsVisible="{Binding IsImportFileMode}">
            <StackPanel Spacing="{StaticResource Space.3}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         FontSize="{StaticResource Font.Size.IconLarge}"
                         HorizontalAlignment="Center"
                         Text="&#xE898;" />
              <TextBlock Text="{Binding SelectedImportFileName}"
                         FontWeight="SemiBold"
                         TextAlignment="Center" />
              <TextBlock Classes="CaptionText"
                         Text="{Binding SelectedImportFileSummary}"
                         TextWrapping="Wrap"
                         TextAlignment="Center" />
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          Spacing="{StaticResource Space.2}">
                <Button Classes="DialogSecondaryButton"
                        Content="{Binding PickFileButtonText}"
                        Command="{Binding PickSwaggerImportFileCommand}" />
                <Button Classes="DialogPrimaryButton"
                        Content="{Binding StartImportButtonText}"
                        Command="{Binding ImportSwaggerFileCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="ProjectImportUrlCard"
                  IsVisible="{Binding IsImportUrlMode}">
            <StackPanel Spacing="{StaticResource Space.3}">
              <TextBlock Classes="SectionTitle"
                         Text="{Binding UrlModeTitle}" />
              <TextBlock Classes="CaptionText"
                         Text="{Binding UrlDescription}" />
              <AutoCompleteBox Classes="ProjectImportUrlInput"
                                ItemsSource="{Binding RecentImportUrls}"
                                MinimumPrefixLength="0"
                                IsTextCompletionEnabled="False"
                                IsDropDownOpen="{Binding IsImportUrlHistoryOpen, Mode=TwoWay}"
                                SearchText="{Binding ImportUrlHistorySearchText, Mode=TwoWay}"
                                PlaceholderText="{Binding UrlWatermark}"
                                Text="{Binding ImportUrl, Mode=TwoWay}">
                <AutoCompleteBox.InnerRightContent>
                  <Button Classes="IconButton"
                          ToolTip.Tip="{Binding ImportUrlHistoryTooltip}"
                          Focusable="False"
                          IsVisible="{Binding HasRecentImportUrls}"
                          Command="{Binding OpenRecentImportUrlsCommand}">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Text="&#xE70D;" />
                  </Button>
                </AutoCompleteBox.InnerRightContent>
              </AutoCompleteBox>
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="{StaticResource Space.2}">
                <Button Classes="DialogPrimaryButton"
                        Content="{Binding ImportUrlButtonText}"
                        Command="{Binding ImportSwaggerUrlCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <Border Classes="ProjectImportBusyOverlay"
              IsVisible="{Binding IsImportDataBusy}">
        <Border Classes="ProjectImportBusyCard"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="{StaticResource Space.3}">
            <TextBlock Text="{Binding ImportDataBusyText}"
                       FontSize="{StaticResource Font.Size.BodyLarge}"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />
            <ProgressBar Classes="ProjectImportBusyProgress"
                         IsIndeterminate="True" />
            <TextBlock Classes="CaptionText"
                       Text="{Binding BusyOverlayDescription}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <Button Classes="DialogSecondaryButton"
                    HorizontalAlignment="Center"
                    Content="取消导入"
                    Command="{Binding CancelImportDataCommand}" />
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</UserControl>
