<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:vm="using:ApixPress.App.ViewModels"
        xmlns:views="using:ApixPress.App.Views.Controls"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="920"
        x:Class="ApixPress.App.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440"
        Height="920"
        MinWidth="1280"
        MinHeight="800"
        WindowState="Maximized"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Icon="/Assets/AppIcon.ico"
        Title="ApixPress">
  <Grid RowDefinitions="Auto,*">
    <views:MainWindowTitleBarView Grid.Row="0" />

    <Grid Grid.Row="1">
      <views:MainWindowHomeView IsVisible="{Binding IsHomeTabActive}" />
      <!-- 标签级缓存宿主：ProjectWorkspaceView 按 ActiveProjectTab 缓存复用，切换项目标签不再整树重建 -->
      <views:ProjectTabHostView Classes="ProjectWorkspaceHost"
                                IsVisible="{Binding HasActiveProjectTab}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
      <!-- 通知中心浮层面板（内部自带可见性绑定）；模态弹窗改由 Ursa OverlayDialogHost 承载 -->
      <views:NotificationCenterOverlayView />
    </Grid>

    <!-- 弹窗宿主必须横跨标题栏与内容两行：宿主是 ClipToBounds 的 Canvas，
         若默认落进 Row 0（47px 标题栏行），弹窗会被裁剪成只剩顶部一条残影 -->
    <u:OverlayDialogHost Grid.Row="0" Grid.RowSpan="2" />
  </Grid>
</Window>
