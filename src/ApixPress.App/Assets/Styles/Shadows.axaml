<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- design-system shadow scale -->
  <BoxShadows x:Key="Shadow.None">0 0 0 0 #00000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Sm">0 1 3 0 #14000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Md">0 4 12 0 #18000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Lg">0 10 24 0 #22000000</BoxShadows>

  <!-- app elevations used by cards / dialogs / focus -->
  <BoxShadows x:Key="Shadow.Card">0 12 30 0 #0F172A0A</BoxShadows>
  <BoxShadows x:Key="Shadow.Card.Raised">0 14 30 0 #0F172A0C</BoxShadows>
  <BoxShadows x:Key="Shadow.Panel">0 10 26 0 #0F172A0D</BoxShadows>
  <BoxShadows x:Key="Shadow.Panel.Raised">0 14 32 0 #0F172A0D</BoxShadows>
  <BoxShadows x:Key="Shadow.Surface">0 16 36 0 #0F172A10</BoxShadows>
  <BoxShadows x:Key="Shadow.Surface.Raised">0 18 36 0 #0F172A18</BoxShadows>
  <BoxShadows x:Key="Shadow.Surface.High">0 18 40 0 #0F172A12</BoxShadows>
  <BoxShadows x:Key="Shadow.Dialog">0 24 60 0 #0F172A20</BoxShadows>
  <BoxShadows x:Key="Shadow.Dialog.Strong">0 28 60 0 #0F172A22</BoxShadows>
  <!-- 右侧抽屉：投影朝左（负 X 偏移，BoxShadow 只接受纯数值，不能带 px） -->
  <BoxShadows x:Key="Shadow.Drawer.Left">-24 0 48 0 #0F172A28</BoxShadows>
  <BoxShadows x:Key="Shadow.Overlay">0 16 40 0 #140F172A</BoxShadows>
  <BoxShadows x:Key="Shadow.Brand.Soft">0 12 28 0 #3844E7D4</BoxShadows>
  <BoxShadows x:Key="Shadow.Brand">0 18 36 0 #4C44E7D4</BoxShadows>
  <BoxShadows x:Key="Shadow.Brand.Tight">0 8 18 0 #3044E7D4</BoxShadows>
  <!-- 首页空状态图标徽章：品牌光环圈 + 柔和落影组合（design-system shadow.brand_ring） -->
  <BoxShadows x:Key="Shadow.Brand.Ring">0 0 0 8 #1A44E7D4, 0 12 28 0 #3844E7D4</BoxShadows>
  <!-- 统一焦点环（T123）：TextBox 聚焦时的品牌色半透明外圈，配合 2px 边框 -->
  <BoxShadows x:Key="Shadow.Focus.Ring">0 0 0 3 #3D44E7D4</BoxShadows>
  <!-- 弹层（Ursa Dialog/Drawer 的 CardBorder）阴影纳入应用海拔 token：Semi 默认 BorderCardBoxShadow 走 SemiShadowElevated。
       必须放本文件：App 资源加载顺序 Colors 先于 Shadows，桥接放 Colors 会因 StaticResource 急切解析找不到 Shadow.Dialog -->
  <StaticResource x:Key="BorderCardBoxShadow" ResourceKey="Shadow.Dialog" />
  <!-- AutoCompleteBox 下拉弹层（T128）：Popup 内容不经过视图资源链，只能在应用级覆盖 Semi 的
       AutoCompleteBoxPopup* 键（与上方 SemiColor* 同一桥接模式）。全应用仅 Headers 页签与导入
       对话框两处 ACB，统一弹层观感：8px 圆角 + 1px 描边 + 海拔阴影 + 与输入框留 4px 间距 + 4px 内衬。
       依赖顺序：Brush.*（Colors 第 1）/ Radius.Md（Spacing 第 3）/ Shadow.Lg（本文件第 4） -->
  <Thickness x:Key="AutoCompleteBoxPopupMargin">0,4,0,0</Thickness>
  <Thickness x:Key="AutoCompleteBoxPopupPadding">4</Thickness>
  <Thickness x:Key="AutoCompleteBoxPopupBorderThickness">1</Thickness>
  <StaticResource x:Key="AutoCompleteBoxPopupCornerRadius" ResourceKey="Radius.Md" />
  <StaticResource x:Key="AutoCompleteBoxPopupBackground" ResourceKey="Brush.Background.Elevated" />
  <StaticResource x:Key="AutoCompleteBoxPopupBorderBrush" ResourceKey="Brush.Border.Default" />
  <StaticResource x:Key="AutoCompleteBoxPopupBoxShadow" ResourceKey="Shadow.Lg" />
</ResourceDictionary>
