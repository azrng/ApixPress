<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- design-system shadow scale -->
  <BoxShadows x:Key="Shadow.None">0 0 0 0 #00000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Sm">0 1 3 0 #14000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Md">0 4 12 0 #18000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Lg">0 10 24 0 #22000000</BoxShadows>

  <!-- app elevations used by cards / dialogs / focus -->
  <BoxShadows x:Key="Shadow.Card">0 12 30 0 #0F172A0A</BoxShadows>
  <BoxShadows x:Key="Shadow.Card.Raised">0 14 30 0 #0F172A0C</BoxShadows>
  <BoxShadows x:Key="Shadow.Panel">0 10 26 0 #0F172A0D</BoxShadows>
  <BoxShadows x:Key="Shadow.Panel.Raised">0 14 32 0 #0F172A0D</BoxShadows>
  <BoxShadows x:Key="Shadow.Surface">0 16 36 0 #0F172A10</BoxShadows>
  <BoxShadows x:Key="Shadow.Surface.Raised">0 18 36 0 #0F172A18</BoxShadows>
  <BoxShadows x:Key="Shadow.Surface.High">0 18 40 0 #0F172A12</BoxShadows>
  <BoxShadows x:Key="Shadow.Dialog">0 24 60 0 #0F172A20</BoxShadows>
  <BoxShadows x:Key="Shadow.Dialog.Strong">0 28 60 0 #0F172A22</BoxShadows>
  <BoxShadows x:Key="Shadow.Overlay">0 16 40 0 #140F172A</BoxShadows>
  <BoxShadows x:Key="Shadow.Brand.Soft">0 12 28 0 #4C84F014</BoxShadows>
  <BoxShadows x:Key="Shadow.Brand">0 18 36 0 #4C84F022</BoxShadows>
  <BoxShadows x:Key="Shadow.Brand.Tight">0 8 18 0 #4C84F020</BoxShadows>
</ResourceDictionary>
