<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="https://irihi.tech/ursa">  <Style Selector="Border.QuickRequestSaveDialogCard">
    <Setter Property="Width" Value="460" />
  </Style>

  <Style Selector="Border.ImportOverwriteConfirmDialogCard">
    <Setter Property="Width" Value="700" />
    <Setter Property="MaxHeight" Value="620" />
  </Style>

  <!-- 项目信息编辑弹窗（对齐原型 06 editProjectModal 宽 460） -->
  <Style Selector="Border.ProjectInfoEditDialogCard">
    <Setter Property="Width" Value="460" />
  </Style>

  <!-- 小型表单弹窗（保存快捷请求/保存为用例/新建目录）：
       表单直接铺放在弹窗正文上（对齐原型 modal-body，不套内层卡片），底栏带分隔线 -->
  <Style Selector="StackPanel.DialogFormStack">
    <Setter Property="Spacing" Value="{StaticResource Space.3}" />
  </Style>

  <Style Selector="StackPanel.DialogFormField">
    <Setter Property="Spacing" Value="{StaticResource Space.2}" />
  </Style>

  <Style Selector="TextBlock.DialogFormLabel">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>

  <Style Selector="TextBlock.DialogFormHint">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
  </Style>

  <Style Selector="Border.DialogFooter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="{StaticResource Pad.Top3}" />
  </Style>

  <Style Selector="Border.RequestCodeDialogCard">
    <Setter Property="Width" Value="960" />
    <Setter Property="MaxHeight" Value="640" />
  </Style>

  <Style Selector="TextBlock.RequestCodeDialogSectionTitle">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodyLarge}" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <Style Selector="TextBox.RequestCodeDialogTextBox">
    <Setter Property="MinHeight" Value="332" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <Style Selector="Border.RequestCodeDialogSidebar">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="4,2,10,2" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
  </Style>

  <Style Selector="StackPanel.RequestCodeDialogLanguageList">
    <Setter Property="Spacing" Value="{StaticResource Space.1}" />
  </Style>

  <Style Selector="ToggleButton.RequestCodeDialogLanguageToggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ToggleButton.RequestCodeDialogLanguageToggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
  </Style>

  <Style Selector="ToggleButton.RequestCodeDialogLanguageToggle:checked">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
  </Style>

  <Style Selector="TextBlock.RequestCodeDialogLanguageGlyph">
    <Setter Property="FontFamily" Value="{StaticResource Font.Monospace}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>

  <Style Selector="TextBlock.RequestCodeDialogLanguageText">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
  </Style>

  <Style Selector="Border.RequestCodeDialogEditorCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style Selector="TabControl.RequestCodeDialogTabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabControl.RequestCodeDialogTabs TabItem">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
  </Style>

  <Style Selector="TabControl.RequestCodeDialogTabs TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <Style Selector="Border.ProjectSettingsInfoCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="{StaticResource Pad.4}" />
  </Style>

  <Style Selector="Border.ProjectSettingsSidebarCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="{StaticResource Pad.3}" />
  </Style>

  <Style Selector="TextBlock.ProjectSettingsGroupTitle">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="Margin" Value="2,0,0,0" />
  </Style>

  <Style Selector="Button.ProjectSettingsSidebarItemButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <Style Selector="Button.ProjectSettingsSidebarItemButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
  </Style>

  <Style Selector="Button.ProjectSettingsSidebarItemButton.ProjectSettingsSidebarItemSelected">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.ProjectSettingsSidebarMetaCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="Padding" Value="{StaticResource Pad.3}" />
  </Style>

  <Style Selector="Border.ProjectSettingsSectionDivider">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Height" Value="1" />
  </Style>

  <Style Selector="Border.ProjectSettingsBasicCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
  </Style>

  <Style Selector="Border.ProjectSettingsBasicRow">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{StaticResource Pad.4}" />
  </Style>

  <Style Selector="Border.ProjectSettingsBasicRow.ProjectSettingsBasicRowLast">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBlock.ProjectSettingsRowLabel">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ProjectSettingsInlineActionButton">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinWidth" Value="60" />
  </Style>

  <Style Selector="Button.ProjectSettingsInlineActionButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
  </Style>

  <Style Selector="ToggleButton.ProjectImportModeButton">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ProjectImportTabStrip">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="ToggleButton.ProjectImportModeTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="0,0,0,2" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodyLarge}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="ToggleButton.ProjectImportModeTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Subtle}" />
  </Style>

  <Style Selector="ToggleButton.ProjectImportModeTab:checked">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
  </Style>

  <Style Selector="ToggleButton.ProjectImportModeTab /template/ ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 导出格式胶囊切换（对齐原型 09 .body-mode：pill 小胶囊 + 6px 间距，选中浅底蓝字加粗） -->
  <Style Selector="ToggleButton.ExportFormatChip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleButton.ExportFormatChip:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <Style Selector="ToggleButton.ExportFormatChip:checked">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.ProjectImportFormatCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="{StaticResource Pad.3}" />
  </Style>

  <Style Selector="Button.ProjectImportCatalogButton">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="{StaticResource Pad.3}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MinWidth" Value="280" />
  </Style>

  <Style Selector="Button.ProjectImportCatalogButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
  </Style>

  <Style Selector="Border.ProjectImportFormatIcon">
    <Setter Property="Background" Value="{DynamicResource Brush.Status.Info.Background}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
  </Style>

  <Style Selector="Border.ProjectImportInputCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="{StaticResource Pad.3}" />
  </Style>

  <Style Selector="Border.ProjectImportDocumentCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="{StaticResource Pad.4}" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style Selector="Border.ProjectImportCountBadge">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinWidth" Value="92" />
  </Style>

  <Style Selector="Border.ProjectImportDialogCard">
    <Setter Property="Width" Value="860" />
  </Style>

  <Style Selector="Border.ProjectImportDialogHeaderCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="{StaticResource Pad.3}" />
  </Style>

  <Style Selector="Border.ProjectImportDialogNoticeCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="{StaticResource Pad.3}" />
  </Style>

  <Style Selector="Border.ProjectImportDropZoneCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Xl}" />
    <Setter Property="Padding" Value="{StaticResource Pad.5}" />
    <Setter Property="MinHeight" Value="300" />
  </Style>

  <Style Selector="Border.ProjectImportUrlCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Xl}" />
    <Setter Property="Padding" Value="{StaticResource Pad.4}" />
  </Style>

  <Style Selector="AutoCompleteBox.ProjectImportUrlInput">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="Padding" Value="{StaticResource Pad.2}" />
    <Setter Property="MinWidth" Value="320" />
  </Style>

  <Style Selector="Border.ProjectImportBusyOverlay">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Overlay}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Xl}" />
  </Style>

  <Style Selector="Border.ProjectImportBusyCard">
    <Setter Property="Width" Value="320" />
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Xl}" />
    <Setter Property="Padding" Value="{StaticResource Pad.4}" />
    <Setter Property="BoxShadow" Value="{StaticResource Shadow.Overlay}" />
  </Style>

  <Style Selector="ProgressBar.ProjectImportBusyProgress">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
  </Style>

  <Style Selector="Border.EnvironmentManagerDialogCard">
    <Setter Property="Width" Value="1040" />
    <Setter Property="Height" Value="680" />
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Xl}" />
    <Setter Property="BoxShadow" Value="{StaticResource Shadow.Dialog.Strong}" />
  </Style>

  <Style Selector="Border.EnvironmentManagerSidebar">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="{StaticResource Pad.4}" />
    <Setter Property="CornerRadius" Value="16,0,0,16" />
  </Style>

  <Style Selector="Button.EnvironmentCreateButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="38" />
  </Style>

  <Style Selector="Border.ProjectSettingsDangerOperationOverlay">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Overlay}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <!-- 环境管理右侧抽屉（对齐原型 07 drawer 形态） -->
  <Style Selector="Border.EnvDrawerPanel">
    <Setter Property="Width" Value="420" />
  </Style>

  <Style Selector="Border.EnvDrawerHead">
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="TextBlock.EnvDrawerTitle">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodyLarge}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <Style Selector="Button.EnvAddButton">
    <Setter Property="Background" Value="{DynamicResource Brush.Brand.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.EnvAddButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Brand.Primary.Strong}" />
  </Style>

  <!-- 环境卡片（对齐原型 env-card） -->
  <Style Selector="Border.EnvCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.EnvCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
  </Style>

  <Style Selector="Border.EnvCard.EnvCardActive">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
  </Style>

  <Style Selector="TextBlock.EnvCardName">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <!-- 环境卡片头按钮：透明铺满，承载点击切换 -->
  <Style Selector="Button.EnvCardHeadButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBlock.EnvCardUrl">
    <Setter Property="FontFamily" Value="{StaticResource Font.Monospace}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
  </Style>

  <Style Selector="Border.EnvCardActiveChip">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="7,1" />
  </Style>

  <Style Selector="TextBlock.EnvCardActiveChipText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Brand.Primary}" />
  </Style>

  <Style Selector="TextBox.EnvCellInput">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
  </Style>

  <Style Selector="TextBox.EnvMonoInput">
    <Setter Property="FontFamily" Value="{StaticResource Font.Monospace}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
  </Style>

  <Style Selector="Button.EnvVarDeleteButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.EnvVarDeleteButton:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Danger}" />
  </Style>

  <!-- 内联删除确认条（对齐原型删除确认 strip） -->
  <Style Selector="Border.EnvDeleteStrip">
    <Setter Property="Background" Value="#0FF87171" />
    <Setter Property="BorderBrush" Value="#66F87171" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="Button.EnvDeleteStripConfirm">
    <Setter Property="Background" Value="{DynamicResource Brush.Border.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.EnvDeleteStripCancel">
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="Button.EnvDrawerDeleteButton">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
  </Style>

  <!-- 用例卡片（对齐原型 case-card） -->
  <Style Selector="Border.CaseCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.CaseCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
  </Style>

  <Style Selector="Border.CaseCard.CaseCardSelected">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Selected}" />
  </Style>

  <Style Selector="TextBlock.CaseCardName">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodySmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <Style Selector="Border.CaseCardLoadedChip">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="7,1" />
  </Style>

  <Style Selector="TextBlock.CaseCardLoadedChipText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Brand.Primary}" />
  </Style>

  <Style Selector="Button.CaseCardOp">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>

  <Style Selector="Button.CaseCardOp:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
  </Style>

  <!-- 覆盖确认：同名接口清单（对齐原型 overwrite modal） -->
  <Style Selector="Border.ImportConflictListCard">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
  </Style>

  <Style Selector="ScrollViewer.ImportConflictListViewport">
    <Setter Property="MaxHeight" Value="270" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="Border.ImportConflictRow">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="TextBlock.ImportConflictMethod">
    <Setter Property="FontFamily" Value="{StaticResource Font.Monospace}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning.Text}" />
  </Style>

  <Style Selector="TextBlock.ImportConflictPath">
    <Setter Property="FontFamily" Value="{StaticResource Font.Monospace}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <Style Selector="TextBlock.ImportConflictExisting">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.ImportConflictWarning">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning.Text}" />
  </Style>

  <Style Selector="Border.DialogDangerNotice">
    <Setter Property="Background" Value="{DynamicResource Brush.Status.Error.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Danger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="Padding" Value="{StaticResource Pad.3}" />
  </Style>

  <Style Selector="Border.ProjectSettingsImportHistoryRow">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{StaticResource Pad.2}" />
  </Style>

  <Style Selector="ToggleButton.ImportResolutionChoice">
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="{StaticResource Pad.3}" />
  </Style>

  <Style Selector="ToggleButton.ImportResolutionChoice:checked">
    <Setter Property="Background" Value="{DynamicResource Brush.Status.Info.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
  </Style>
</Styles>
